# User-supplied game data and generated binaries stay local.
*.iso
*.gcm
*.rvz
*.z64
*.dol
*.raw
*.sav
.env
.env.*
!.env.example
# Pinned third-party engine checkouts; recreate with scripts/setup-engine.mjs.
/engines/gecko/
/engines/wasm-dolphin/
# Local native renderer and build toolchain.
/engines/dolphin-native/
/.local-tools/
/.browser-tools/
/.melee-native/
# Independent reference repositories (their own Git history remains intact).
/melee/
/opensmash/
# UI textures decoded from the user's local disc; regenerated at startup.
/.melee-assets/

# Reproducible browser release artifacts.
/dist/
# User-supplied Slippi reference distributions.
/Slippi-Launcher-*.AppImage
/Slippi-Nintendont-*.zip

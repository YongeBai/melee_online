@@ -0,0 +1,29 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createMaterialRenderer} from '../../engines/browser-native/material-gpu.mjs';
+import {createPresentationCache} from '../../engines/browser-native/presentation-cache.mjs';
+
+function fixture(){
+ const counts={compiled:0,linked:0,freed:0,deleted:0},canvas=new EventTarget();let forbidden=false,lost=false;
+ const module=new Proxy({_malloc:()=>48,_free:()=>counts.freed++},{get(target,key){if(forbidden)throw Error('Native access during compilation: '+String(key));return target[key];},set(target,key,value){if(forbidden)throw Error('Native write during compilation');target[key]=value;return true;}});
+ const gl={canvas,VERTEX_SHADER:1,FRAGMENT_SHADER:2,COMPILE_STATUS:3,LINK_STATUS:4,INTERLEAVED_ATTRIBS:5,
+  isContextLost:()=>lost,getExtension:()=>null,createShader:type=>({type}),shaderSource(s,text){s.text=text;},compileShader(){counts.compiled++;},getShaderParameter:()=>true,
+  createProgram:()=>({}),attachShader(){},transformFeedbackVaryings(){},linkProgram(){counts.linked++;},getProgramParameter:()=>true,deleteShader(){},deleteProgram(){counts.deleted++;}};
+ return {counts,module,gl,denyNative:v=>{forbidden=v;},lose(){lost=true;canvas.dispatchEvent(new Event('webglcontextlost'));},restore(){lost=false;}};
+}
+const sources=n=>({vertex:'#version 300 es\n// vertex '+n,fragment:'#version 300 es\n// fragment '+n});
+test('preparation compiles exact source pairs once, shares the actual cache, and makes no native accesses',()=>{
+ const f=fixture(),cache=createPresentationCache({uniformBuffer:false}),a=createMaterialRenderer(f.gl,f.module,{presentationCache:cache}),catalog=[sources(1),sources(2)],copy=JSON.stringify(catalog);
+ f.denyNative(true);const prepared=a.prewarm([...catalog,catalog[0]]);f.denyNative(false);
+ assert.equal(prepared.compiled,2);assert.equal(f.counts.linked,2);assert.equal(JSON.stringify(catalog),copy);assert.deepEqual(a.shaderSources(),catalog);assert.deepEqual(a.shaderCoverage(),{programs:2,prepared:2,preparedUsed:0,unpreparedUsed:0});a.dispose();
+ const b=createMaterialRenderer(f.gl,f.module,{presentationCache:cache});f.denyNative(true);assert.equal(b.prewarm(catalog).compiled,0);assert.equal(b.prewarm([{...catalog[0],fragment:catalog[0].fragment+'\n// changed'}]).compiled,1);assert.equal(b.prewarm([{...catalog[0],vertex:catalog[0].vertex+'\n// changed'}]).compiled,1);f.denyNative(false);b.dispose();cache.dispose();assert.equal(f.counts.deleted,4);
+});
+test('shader preparation is isolated between caches and must recompile after context loss/restoration',()=>{
+ const f=fixture(),first=createPresentationCache({uniformBuffer:false});let a=createMaterialRenderer(f.gl,f.module,{presentationCache:first});assert.equal(a.prewarm([sources(1)]).compiled,1);a.dispose();
+ const independent=createPresentationCache({uniformBuffer:false});a=createMaterialRenderer(f.gl,f.module,{presentationCache:independent});assert.equal(a.prewarm([sources(1)]).compiled,1);a.dispose();independent.dispose();
+ f.lose();assert.throws(()=>first.acquire(f.gl),/context unavailable/);f.restore();assert.throws(()=>first.acquire(f.gl),/context unavailable/);first.dispose();
+ const recovered=createPresentationCache({uniformBuffer:false});a=createMaterialRenderer(f.gl,f.module,{presentationCache:recovered});assert.equal(a.prewarm([sources(1)]).compiled,1);a.dispose();recovered.dispose();assert.equal(f.counts.linked,3);
+});
+test('failed shader links are rejected, deleted and never marked prepared',()=>{
+ const f=fixture();f.gl.getProgramParameter=()=>false;f.gl.getProgramInfoLog=()=> 'unsupported variant';const cache=createPresentationCache({uniformBuffer:false}),a=createMaterialRenderer(f.gl,f.module,{presentationCache:cache});assert.throws(()=>a.prewarm([sources(1)]),/unsupported variant/);assert.equal(a.shaderCoverage().prepared,0);assert.equal(f.counts.deleted,1);a.dispose();cache.dispose();
+});

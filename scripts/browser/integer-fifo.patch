+// Match the general MMU path only for the canonical BAT-mapped FIFO address.
+// DBAT changes invalidate generated code through MMU::DBATUpdated/ClearSafe.
+// Flush at 32 bytes after each integer store, matching MMU Write8/16/32.
+bool EmitIntegerFifoStore(std::vector<u8>& body, const WasmStateLayout& layout, u32 bytes)
+{
+  if (!DolphinWebFeatureEnabled(DOLPHIN_WEB_ENABLE_INTEGER_FIFO) ||
+      !Core::System::GetInstance().GetMMU().IsOptimizableGatherPipeWrite(0xcc008000u))
+    return false;
+  EmitLocalGet(body, 1);
+  EmitI32Const(body, 0xcc008000u);
+  body.push_back(0x46);
+  EmitStateLoadU32(body, layout.msr_offset);
+  EmitI32Const(body, (1u << 4) | 1u); // DR on, little-endian off
+  body.push_back(0x71);
+  EmitI32Const(body, 1u << 4);
+  body.push_back(0x46);
+  body.push_back(0x71);
+  body.push_back(0x04); body.push_back(0x40);
+  if (bytes == 4) EmitBswap32FromLocal(body, 2);
+  else if (bytes == 2) EmitBswap16FromLocal(body, 2);
+  else EmitLocalGet(body, 2);
+  EmitLocalSet(body, 3);
+  EmitStateLoadU32(body, layout.gather_pipe_ptr_offset);
+  EmitLocalGet(body, 3);
+  body.push_back(bytes == 4 ? 0x36 : bytes == 2 ? 0x3b : 0x3a);
+  body.push_back(0x00); EmitU32Leb(body, 0);
+  EmitStateStoreU32Prefix(body);
+  EmitStateLoadU32(body, layout.gather_pipe_ptr_offset);
+  EmitI32Const(body, bytes); body.push_back(0x6a);
+  EmitStateStoreU32Suffix(body, layout.gather_pipe_ptr_offset);
+  EmitStateLoadU32(body, layout.gather_pipe_ptr_offset);
+  EmitStateLoadU32(body, layout.gather_pipe_base_ptr_offset);
+  body.push_back(0x6b);
+  EmitI32Const(body, GPFifo::GATHER_PIPE_SIZE);
+  body.push_back(0x4f);
+  body.push_back(0x04); body.push_back(0x40);
+  EmitLocalGet(body, 0); EmitI32Const(body, 0); EmitI32Const(body, 0);
+  body.push_back(0x10); EmitU32Leb(body, WASM_IMPORT_FASTCHECK_GPFIFO_INDEX);
+  body.push_back(0x0b);
+  body.push_back(0x05); // caller emits unchanged MMU fallback
+  return true;
+}

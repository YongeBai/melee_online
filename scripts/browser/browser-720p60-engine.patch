+EMSCRIPTEN_KEEPALIVE int BrowserFrameBenchmarkStopAfterFrames(int frames)
+{
+  auto& system=Core::System::GetInstance();
+  if (!s_runtime_initialized || frames<120 || frames>3600 || Core::GetState(system)!=Core::State::Paused)return 0;
+  const Core::CPUThreadGuard guard(system);
+  const std::lock_guard<std::mutex> lock(s_input_state_mutex);
+  auto& b=s_frame_benchmark;
+  if (!b.active || b.have_frame || b.stop_after || s_rollback_input_owner)return 0;
+  b.stop_after=frames;return 1;
+}
+EMSCRIPTEN_KEEPALIVE const char* BrowserFrameBenchmarkStats()
+{
+  static std::string result;
+  const std::lock_guard<std::mutex> lock(s_input_state_mutex);const auto& b=s_frame_benchmark;
+  std::ostringstream out;
+  out<<"{\"active\":"<<(b.active?"true":"false")<<",\"valid\":"<<(b.valid?"true":"false")
+     <<",\"completed\":"<<(b.completed?"true":"false")<<",\"stopAfterFrames\":"<<b.stop_after<<",\"stoppedFrame\":"<<b.stopped_frame
+     <<",\"inputHash\":"<<b.input_hash<<",\"stateHash\":"<<b.state_hash
+     <<",\"startFrame\":"<<b.start<<",\"lastFrame\":"<<b.last<<",\"frames\":"<<b.frames<<",\"skipped\":"<<b.skipped
+     <<",\"inputChanges\":["<<b.changes[0]<<","<<b.changes[1]<<"],\"observedActions\":[";
+  for (u32 p=0;p<2;++p) {if(p)out<<",";out<<"[";bool comma=false;for(u32 a=0;a<512;++a)if(b.actions[p][a]){if(comma)out<<",";comma=true;out<<a;}out<<"]";}
+  out<<"],\"digests\":[";
+  for (std::size_t i=0;i<b.digests.size();++i) {if(i)out<<",";const auto& d=b.digests[i];out<<"{\"frame\":"<<d.frame<<",\"input\":"<<d.input<<",\"state\":"<<d.state<<"}";}
+  out<<"],\"gaps\":[";
+  for(std::size_t i=0;i<b.gaps.size();++i){if(i)out<<",";out<<"{\"after\":"<<b.gaps[i].after<<",\"before\":"<<b.gaps[i].before<<"}";}
+  out<<"]}";result=out.str();return result.c_str();
+}

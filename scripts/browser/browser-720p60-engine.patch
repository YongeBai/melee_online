+  writeSection(output, 3, functionSection);
+
+  const tableSection = [0x01, 0x70, 0x00];
+  writeU32Leb(tableSection, count);
+  writeSection(output, 4, tableSection);
+
+  // Export a single funcref table rather than thousands of named functions.
+  writeSection(output, 7, [0x01, 0x01, 0x74, 0x01, 0x00]);
+
+  const elementSection = [0x01, 0x00, 0x41, 0x00, 0x0b];
+  writeU32Leb(elementSection, count);
+  const firstFunction = template.importShape.functions;
+  for (let i = 0; i < count; i += 1) writeU32Leb(elementSection, firstFunction + i);
+  writeSection(output, 9, elementSection);
+
+  const codeSection = [];
+  writeU32Leb(codeSection, count);
+  for (const entry of list) appendBytes(codeSection, entry.module.body);
+  writeSection(output, 10, codeSection);
+
+  return {
+    bytes: Uint8Array.from(output),
+    indexByHash: new Map(list.map((entry, index) => [entry.hash, index])),
+    entryCount: count,
+  };
+}

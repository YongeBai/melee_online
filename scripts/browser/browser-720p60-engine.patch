+
+function writeU32Leb(out, value) {
+  let remaining = Number(value) >>> 0;
+  do {
+    let byte = remaining & 0x7f;
+    remaining >>>= 7;
+    if (remaining) byte |= 0x80;
+    out.push(byte);
+  } while (remaining);

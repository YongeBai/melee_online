+    DolphinWeb_SetPairedSimd(simd);
+    DolphinWeb_SetPairedMemorySimd(memory_simd);
+    DolphinWeb_SetVectorFprCache(vector_fpr);
+    DolphinWeb_SetPsqHoist(psq_hoist);
+    DolphinWeb_SetQStateCache(qstate_cache);
+    DolphinWeb_SetQStateFull(qstate_full);
+    DolphinWeb_SetBswapRotate(bswap_rotate);
+    DolphinWeb_SetChainFusion(chain_fusion);
+    DolphinWeb_SetCallFusion(call_fusion);
+    DolphinWeb_SetMeleeMatrixFast(melee_matrix_fast);
+    DolphinWeb_SetMeleeAnimStateFast(melee_anim_state_fast);
+    DolphinWeb_SetMeleeDisplayListFast(melee_display_list_fast);

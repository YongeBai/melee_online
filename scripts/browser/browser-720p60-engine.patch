diff --git a/tests/jit-block-bundle.test.mjs b/tests/jit-block-bundle.test.mjs
new file mode 100644
index 0000000..fb737d4
--- /dev/null
+++ b/tests/jit-block-bundle.test.mjs
@@ -0,0 +1,72 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { buildJitBlockBundle } from "../src/jit-block-bundle.js";
+
+function u32(value) {
+  const out = [];
+  do {
+    let byte = value & 0x7f;
+    value >>>= 7;
+    if (value) byte |= 0x80;
+    out.push(byte);
+  } while (value);
+  return out;
+}
+
+function section(id, body) {
+  return [id, ...u32(body.length), ...body];
+}
+
+function block(constant) {
+  const type = [
+    2,
+    0x60, 1, 0x7f, 1, 0x7f,
+    0x60, 2, 0x7f, 0x7f, 1, 0x7f,
+  ];
+  const imports = [
+    2,
+    3, 0x65, 0x6e, 0x76, 3, 0x61, 0x64, 0x64, 0, 1,
+    3, 0x65, 0x6e, 0x76, 6, 0x6d, 0x65, 0x6d, 0x6f, 0x72, 0x79, 2, 3, 1, 1,
+  ];
+  // (x) => add(x, constant)
+  const body = [0, 0x20, 0, 0x41, ...u32(constant), 0x10, 0, 0x0b];
+  return Uint8Array.from([
+    0, 0x61, 0x73, 0x6d, 1, 0, 0, 0,
+    ...section(1, type),
+    ...section(2, imports),
+    ...section(3, [1, 0]),
+    ...section(7, [1, 1, 0x66, 0, 1]),
+    ...section(10, [1, ...u32(body.length), ...body]),
+  ]);
+}
+
+test("bundles one-function JIT modules into one instance and exported table", async () => {
+  const bundle = buildJitBlockBundle([
+    { hash: "a", bytes: block(3) },
+    { hash: "b", bytes: block(11) },
+  ]);
+  assert.equal(bundle.entryCount, 2);
+  assert.deepEqual([...bundle.indexByHash], [["a", 0], ["b", 1]]);
+  assert.equal(WebAssembly.validate(bundle.bytes), true);
+  const memory = new WebAssembly.Memory({ initial: 1, maximum: 1, shared: true });
+  const instance = await WebAssembly.instantiate(bundle.bytes, {
+    env: { memory, add: (a, b) => a + b },
+  });
+  assert.equal(instance.instance.exports.t.get(0)(7), 10);
+  assert.equal(instance.instance.exports.t.get(1)(7), 18);
+});
+
+test("rejects ABI mismatches instead of mixing incompatible blocks", () => {
+  const changed = block(4);
+  // Rename the imported helper from add to sub.
+  const addName = [0x61, 0x64, 0x64];
+  const addOffset = changed.findIndex((byte, index) =>
+    byte === addName[0] && changed[index + 1] === addName[1] && changed[index + 2] === addName[2]
+  );
+  changed[addOffset] = 0x73;
+  assert.throws(
+    () => buildJitBlockBundle([{ hash: "a", bytes: block(3) }, { hash: "b", bytes: changed }]),
+    /ABI mismatch/
+  );
+});

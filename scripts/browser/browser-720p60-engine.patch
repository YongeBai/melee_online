+  const u32 next = (previous & ~(regcache_disable | fastmem_enable | integer_fifo_enable | single_prefix_enable | fpr_cache_enable | block_merge_disable)) |
+      ((flags & 1) ? 0 : regcache_disable) | ((flags & 2) ? fastmem_enable : 0) | ((flags & 4) ? integer_fifo_enable : 0) | ((flags & 8) ? single_prefix_enable : 0) | ((flags & 16) ? fpr_cache_enable : 0) | ((flags & 65536) ? 0 : block_merge_disable);

+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+// Private QA input only. Reads the native game on its CPU thread and returns
+// ordinary controller states; it never writes game memory or changes rules.
+namespace DolphinWeb::FrameBenchmark
+{
+using u32=std::uint32_t;
+using Pad=std::array<u32,9>;
+struct Fighter { float x=0; u32 action=0,stocks=0; };
+struct State { u32 frame=0; std::array<Fighter,2> fighters{}; };
+inline bool Read(const std::uint8_t* ram, std::size_t bytes, State* out)
+{
+  if (!ram || bytes<0x1800000 || !out || std::memcmp(ram,"GALE01",6)!=0 || ram[7]!=2) return false;
+  const auto valid=[](u32 p,u32 n) {return !(p&3) && p>=0x80003100 && n<=0x1800000 && p<=0x81800000-n;};
+  const auto word=[&](u32 p) {const auto* b=ram+(p-0x80000000);return (u32(b[0])<<24)|(u32(b[1])<<16)|(u32(b[2])<<8)|b[3];};
+  const auto byte=[&](u32 p) {return ram[p-0x80000000];};
+  const u32 scene=word(0x804d6720);
+  if (byte(0x80479d30)!=2 || byte(0x80479d33)!=2 || !valid(scene,4) || byte(scene)!=2) return false;
+  State s{};s.frame=word(0x80479d58);
+  for (u32 port=0;port<2;++port)
+  {
+    const u32 slot=0x80453080+port*0xe90,index=byte(slot+0xc);
+    if (index>=2 || word(slot+8)!=0 || byte(slot+0x46)!=port) return false;
+    const u32 gobj=word(slot+0xb0+index*4);
+    if (!valid(gobj,0x30)) return false;
+    const u32 fp=word(gobj+0x2c);
+    if (!valid(fp,0xb4) || word(fp)!=gobj) return false;
+    const u32 bits=word(fp+0xb0);std::memcpy(&s.fighters[port].x,&bits,4);
+    if (!std::isfinite(s.fighters[port].x)) return false;
+    s.fighters[port].action=word(fp+0x10);s.fighters[port].stocks=byte(slot+0x8e);
+  }
+  *out=s;return true;
+}
+inline Pad Input(const State& state,u32 port)
+{
+  Pad p{0,128,128,128,128,0,0,0,0};if (port>=2 || !state.fighters[port].stocks) return p;
+  const auto& actor=state.fighters[port];const auto& other=state.fighters[1-port];
+  const u32 phase=(state.frame/9+port*7)%24;
+  const int inward=actor.x>0?-1:1,toward=other.x>=actor.x?1:-1;
+  if (std::fabs(actor.x)>50) {p[1]=128+inward*96;if (phase%3==0)p[0]=4;return p;}
+  if (phase<6 || phase>=20)p[1]=128+toward*80;
+  if (phase==3 || phase==7 || phase==11 || phase==17 || phase==21){p[0]=1;p[7]=255;}
+  if (phase==6 || phase==15)p[0]=4;
+  if (phase==9 || phase==18){p[0]=2;p[8]=255;}
+  if (phase==13){p[0]=32;p[5]=255;}
+  if (phase==23)p[3]=128+toward*96;
+  return p;
+}
+inline u32 HashWord(u32 hash,u32 word) {return (hash^word)*16777619u;}
+}

+  const bool simd = (flags & 64) != 0;
+  const bool memory_simd = (flags & 128) != 0;
+  const bool vector_fpr = (flags & 256) != 0;
+  const bool constant_address = (extra_flags & 1) != 0;
+  const bool melee_matrix_fast = (extra_flags & 2) != 0;
+  const bool melee_anim_state_fast = (extra_flags & 4) != 0;
+  const bool melee_display_list_fast = (extra_flags & 8) != 0;
+  const bool melee_gx_matrix_fast = (extra_flags & 16) != 0;
+  const bool melee_anim_callback_fast = (extra_flags & 32) != 0;
+  const bool melee_anim_fusion = (extra_flags & 64) != 0;
+  const bool melee_hot_fusion = (extra_flags & 128) != 0;
+  const bool call_fusion = (flags & 1073741824) != 0;
+  const bool chain_fusion = (flags & 536870912) != 0;
+  const bool bswap_rotate = (flags & 268435456) != 0;
+  const bool qstate_full = (flags & 134217728) != 0;
+  const bool qstate_cache = (flags & 67108864) != 0;
+  const bool psq_hoist = (flags & 512) != 0;
+  const bool wide_map = (flags & 1024) != 0;
+  const bool constant_state_base = (flags & 2048) != 0;
+  const bool block_msr_cache = (flags & 4096) != 0;
+  const bool fifo_copy = (flags & 8192) != 0;
+  const bool fifo_batch = (flags & 16384) != 0;
+  const bool frsqrte_fast = (flags & 32768) != 0;
+  const bool fpu_guard = (flags & 131072) != 0;
+  const bool branch_fusion = (flags & 262144) != 0;
+  const bool fpu_wide = (flags & 524288) != 0;

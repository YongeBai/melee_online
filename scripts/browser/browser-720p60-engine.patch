+  const bool fusion_redispatch = (flags & 4194304) != 0;
+  const bool counter_batch = (flags & 8388608) != 0;
+  const bool lean_dispatch = (flags & 16777216) != 0;
+  const bool cp_format_reuse = (flags & 33554432) != 0;
+  if (constant_address != DolphinWeb_GetConstantAddress() || melee_matrix_fast != DolphinWeb_GetMeleeMatrixFast() || melee_anim_state_fast != DolphinWeb_GetMeleeAnimStateFast() || melee_display_list_fast != DolphinWeb_GetMeleeDisplayListFast() || melee_gx_matrix_fast != DolphinWeb_GetMeleeGxMatrixFast() || melee_anim_fusion != DolphinWeb_GetMeleeAnimFusion() || melee_hot_fusion != DolphinWeb_GetMeleeHotFusion() || call_fusion != DolphinWeb_GetCallFusion() || chain_fusion != DolphinWeb_GetChainFusion() || bswap_rotate != DolphinWeb_GetBswapRotate() || qstate_full != DolphinWeb_GetQStateFull() || qstate_cache != DolphinWeb_GetQStateCache() || next != previous || compact != DolphinWeb_GetCompactGprLocals() || simd != DolphinWeb_GetPairedSimd() || memory_simd != DolphinWeb_GetPairedMemorySimd() || vector_fpr != DolphinWeb_GetVectorFprCache() || psq_hoist != DolphinWeb_GetPsqHoist() || wide_map != DolphinWeb_GetWideBlockMap() || constant_state_base != DolphinWeb_GetConstantStateBase() || block_msr_cache != DolphinWeb_GetBlockMsrCache() || fifo_copy != DolphinWeb_GetFifoCopy() || fifo_batch != DolphinWeb_GetFifoBatch() || frsqrte_fast != DolphinWeb_GetFrsqrteFast() || fpu_guard != DolphinWeb_GetFpuGuardHoist() || branch_fusion != DolphinWeb_GetConditionalFusion() || fpu_wide != DolphinWeb_GetFpuGuardWide() || step_check != DolphinWeb_GetStepCheck() || read_fusion != DolphinWeb_GetReadFusion() || fusion_redispatch != DolphinWeb_GetFusionRedispatch())
+  {
+    system.GetJitInterface().ClearCache(guard);

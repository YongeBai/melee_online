+// QA-only code-generation comparison. Generated blocks must be discarded when
+// changing these flags, otherwise a test could unknowingly reuse old code.
+EMSCRIPTEN_KEEPALIVE int BrowserRollbackConfigureCodegen(int flags)
+{
+  auto& system = Core::System::GetInstance();
+  if (!s_runtime_initialized || flags < 0 || flags > 3 ||
+      Core::GetState(system) != Core::State::Paused ||
+      s_cpu_core != PowerPC::CPUCore::CachedInterpreter) return 0;
+  const Core::CPUThreadGuard guard(system);
+  constexpr u32 regcache_disable = 1u << 20;
+  constexpr u32 fastmem_enable = 1u << 23;
+  const u32 previous = DolphinWeb_GetCachedInterpreterDisableMask();
+  const u32 next = (previous & ~(regcache_disable | fastmem_enable)) |
+      ((flags & 1) ? 0 : regcache_disable) | ((flags & 2) ? fastmem_enable : 0);
+  if (next != previous)
+  {
+    system.GetJitInterface().ClearCache(guard);
+    DolphinWeb_SetCachedInterpreterDisableMask(next);
+  }
+  return 1;
+}

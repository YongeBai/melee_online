+EMSCRIPTEN_KEEPALIVE int BrowserRollbackSetPads(const u32* packed, int count, u32 frame)
+{
+  auto& system = Core::System::GetInstance();
+  if (!s_runtime_initialized || !packed || count != 18 ||
+      Core::GetState(system) != Core::State::Paused) return 0;
+  std::array<InputStateSnapshot, 2> next{};
+  for (unsigned port = 0; port < 2; ++port)
+  {
+    const auto* p = packed + port * 9;
+    if (p[0] > 0xfffffu) return 0;
+    for (unsigned field = 1; field < 9; ++field) if (p[field] > 255) return 0;
+    auto& input = next[port];
+    input.mask = p[0]; input.generation = frame;
+    input.stick_x = p[1]; input.stick_y = p[2];
+    input.c_stick_x = p[3]; input.c_stick_y = p[4];
+    input.trigger_left = p[5]; input.trigger_right = p[6];
+    input.analog_a = p[7]; input.analog_b = p[8];
+  }
+  const Core::CPUThreadGuard guard(system);
+  const std::lock_guard<std::mutex> lock(s_input_state_mutex);
+  s_rollback_inputs = next;
+  s_rollback_input_owner = true;
+  return 1;
+}
+EMSCRIPTEN_KEEPALIVE void BrowserRollbackReleasePads()
+{
+  const std::lock_guard<std::mutex> lock(s_input_state_mutex);
+  s_rollback_input_owner = false;
+}

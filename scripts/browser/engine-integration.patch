+EMSCRIPTEN_KEEPALIVE int BrowserRollbackGameStep()
+{
+  auto& system = Core::System::GetInstance();
+  if (!s_runtime_initialized || Core::GetState(system) != Core::State::Paused ||
+      SConfig::GetInstance().GetGameID() != "GALE01" || SConfig::GetInstance().GetRevision() != 2 ||
+      s_cpu_core != PowerPC::CPUCore::CachedInterpreter)
+    return 0;
+  {
+    const Core::CPUThreadGuard guard(system);
+    auto& memory = system.GetMemory();
+    if (!memory.GetRAM() || memory.GetRamSize() < 0x00479d58 + sizeof(u32)) return 0;
+    DolphinWeb_ArmGameFrameStep(memory.GetRAM() + 0x00479d58);
+  }
+  Core::SetState(system, Core::State::Running);
+  return 1;

+// Opt-in direct-block profiler. Call only while CPU ownership is paused.
+EMSCRIPTEN_KEEPALIVE const char* BrowserDispatchProfile(int mode)
+{
+  auto& system = Core::System::GetInstance();
+  if (!s_runtime_initialized || mode < -1 || mode > 1 || Core::GetState(system) != Core::State::Paused)
+    return "{\"error\":\"Dispatch profiling requires a paused machine and -1/0/1\"}";
+  const Core::CPUThreadGuard guard(system);
+  if (mode == 1) DolphinWeb::DispatchProfile::Reset();
+  if (mode != -1) DolphinWeb::DispatchProfile::enabled.store(mode != 0, std::memory_order_relaxed);
+  static std::string result;
+  result = DolphinWeb::DispatchProfile::Report();
+  return result.c_str();
+}

+// Copyright 2026
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <cstdint>
+namespace DolphinWeb::RollbackOutput {
+// Host presentation only. Game DSP/GX execution and serialized state still run.
+inline std::atomic<bool> suppressed{false};
+inline std::atomic<std::uint64_t> video_skipped{0};
+inline std::atomic<std::uint64_t> audio_skipped{0};
+}

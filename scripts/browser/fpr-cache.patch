+// Opt-in bit19: paired-single register cache. Use f64 locals for FP arithmetic,
+// preserving loaded NaN payloads and bitcasting integer/FP aliases. Eager loads cover both arms
+// of generated conditionals; dirty is sticky across helpers and branches.
+struct WasmFprRegCache
+{
+  bool active = false;
+  u32 base = 0, local_base = 40, scratch_local = 0;
+  u32 locals[64] = {};
+  bool present[64] = {};
+  bool dirty[64] = {};
+};
+static WasmFprRegCache s_fpr_rc;
+bool FprCacheIndex(u32 offset, u32* index)
+{
+  if (!s_fpr_rc.active || offset < s_fpr_rc.base) return false;
+  const u32 rel = offset - s_fpr_rc.base;
+  if (rel >= 64 * sizeof(u64) || rel % sizeof(u64)) return false;
+  *index = rel / sizeof(u64);
+  return s_fpr_rc.present[*index];
+}
+void ConfigureFprCacheLocals(std::vector<u8>& body, u32 used_regs)
+{
+  if (!s_fpr_rc.active) return;
+  if (used_regs == 0) { s_fpr_rc.active = false; return; }
+  u32 count = 0;
+  for (u32 reg = 0; reg < 32; ++reg)
+  {
+    if (!(used_regs & (1u << reg))) continue;
+    for (u32 lane = reg * 2; lane < reg * 2 + 2; ++lane)
+    {
+      s_fpr_rc.present[lane] = true;
+      s_fpr_rc.locals[lane] = s_fpr_rc.local_base + count++;
+    }
+  }
+  // Unused locals are still zero-initialized by baseline WASM compilers.
+  // Declare only referenced lanes, and none for integer-only blocks.
+  body[0] += 2;
+  EmitU32Leb(body, count); body.insert(body.end(), {0x7c, 0x01, 0x7e});
+  s_fpr_rc.scratch_local = s_fpr_rc.local_base + count;
+}
+void EmitFprCacheFlush(std::vector<u8>& body)
+{
+  if (!s_fpr_rc.active) return;
+  for (u32 i=0; i<64; ++i)
+  {
+    if (!s_fpr_rc.present[i] || !s_fpr_rc.dirty[i]) continue;
+    EmitLocalGet(body, 0); EmitLocalGet(body, s_fpr_rc.locals[i]);
+    body.insert(body.end(), {0x39, 0x03});
+    EmitU32Leb(body, s_fpr_rc.base+i*sizeof(u64));
+  }
+}
+void EmitFprCacheReload(std::vector<u8>& body)
+{
+  if (!s_fpr_rc.active) return;
+  for (u32 i=0; i<64; ++i)
+  {
+    if (!s_fpr_rc.present[i]) continue;
+    EmitLocalGet(body, 0); body.insert(body.end(), {0x2b, 0x03});
+    EmitU32Leb(body, s_fpr_rc.base+i*sizeof(u64));
+    EmitLocalSet(body, s_fpr_rc.locals[i]);
+  }
+}

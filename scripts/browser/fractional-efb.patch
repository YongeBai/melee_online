+// Private paused QA control. Normal startup remains at its measured scale.
+EMSCRIPTEN_KEEPALIVE int BrowserRenderScalePercent(int percent)
+{
+  const int current = Config::Get(Config::GFX_EFB_SCALE);
+  if (percent == 0) return current == 150 ? 150 : current * 100;
+  auto& system = Core::System::GetInstance();
+  if (!s_runtime_initialized || s_video_backend != "OGL" ||
+      Core::GetState(system) != Core::State::Paused ||
+      (percent != 150 && percent != 200)) return 0;
+  const Core::CPUThreadGuard guard(system);
+  Config::SetBase(Config::GFX_EFB_SCALE, percent == 150 ? 150 : 2);
+  return percent;
+}

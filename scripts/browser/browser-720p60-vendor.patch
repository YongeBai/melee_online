+bool CachedInterpreter::TryWriteMeleeDisplayList(PowerPC::PowerPCManager& power_pc)
+{
+  constexpr u32 start = 0x803410d8;
+  constexpr u32 suffix = 0x80341108;
+  constexpr u32 tail = 0x8034111c;
+  constexpr std::array<u32, 28> expected = {

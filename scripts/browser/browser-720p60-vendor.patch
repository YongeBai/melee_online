+      0x803700b4});
+  const auto rotation_independent = make_path({
+      0x803700c4, 0x803700c8, 0x803700cc, 0x803700e0, 0x803700e4, 0x803700e8,
+      0x803700fc, 0x80370100, 0x80370104, 0x80370108});
+  const auto rotation_dirty = make_path({
+      0x803700c4, 0x803700c8, 0x803700cc, 0x803700e0, 0x803700e4, 0x803700e8,
+      0x803700fc, 0x80370100, 0x80370104, 0x80370108, 0x8037010c, 0x80370110,
+      0x80370114, 0x80370128, 0x8037012c, 0x80370130, 0x80370134, 0x80370138,
+      0x8037013c, 0x80370140, 0x80370144, 0x80370148});
+  const auto translation_independent = make_path({
+      0x803701ec, 0x803701f0, 0x803701f4, 0x80370208, 0x8037020c, 0x80370210,
+      0x80370214});
+  const auto translation_dirty = make_path({
+      0x803701ec, 0x803701f0, 0x803701f4, 0x80370208, 0x8037020c, 0x80370210,
+      0x80370214, 0x80370218, 0x8037021c, 0x80370220, 0x80370234, 0x80370238,
+      0x8037023c, 0x80370240, 0x80370244, 0x80370248, 0x8037024c, 0x80370250,

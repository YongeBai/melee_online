+    }
+    for (u32 i = 0; i < write_mtx_expected.size(); ++i)
+    {
+      if (!add_instruction(middle, write_mtx_start + i * sizeof(u32), write_mtx_expected[i]))
+        return false;
+    }
+  }
+  else
+  {
+    for (u32 i = 0; i < set_index_expected.size(); ++i)
+    {
+      const u32 address = set_index_start + i * sizeof(u32);
+      const auto result = m_system.GetMMU().TryReadInstruction(address);
+      if (!result.valid || result.hex != set_index_expected[i])
+        return false;
+      const GekkoOPInfo& opinfo = *PPCTables::GetOpInfo(UGeckoInstruction{result.hex}, address);
+      const auto add = [&](std::array<u32, 3>& metric) {
+        metric[0] += opinfo.num_cycles;
+        if ((opinfo.flags & FL_LOADSTORE) != 0)
+          ++metric[1];
+        if ((opinfo.flags & FL_USE_FPU) != 0)
+          ++metric[2];
+      };
+      if (i <= 1)
+        add(entry);
+      else if (i <= 15)
+        add(middle);
+      else if (i >= 29)
+        add(tail);
+      if (i >= 16)
+        add(alternate);
+    }
+  }
+
+  Write(FastMeleeGxMatrix, {power_pc, js.blockStart, entry, middle, tail, alternate});
+  s_melee_gx_matrix_compiles.fetch_add(1, std::memory_order_relaxed);
+  return true;
+}

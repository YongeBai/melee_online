+  add_metric(flush_prefix,
+             *PPCTables::GetOpInfo(UGeckoInstruction{expected[16]}, start + 16 * sizeof(u32)));
+  for (u32 i = 0; i < flush_expected.size(); ++i)
+  {
+    const u32 address = flush_start + i * sizeof(u32);
+    const auto result = m_system.GetMMU().TryReadInstruction(address);
+    if (!result.valid || result.hex != flush_expected[i])
+      return false;
+    const GekkoOPInfo& opinfo = *PPCTables::GetOpInfo(UGeckoInstruction{result.hex}, address);
+    if (i <= 12)
+      add_metric(flush_blocks[0], opinfo);
+    if (i >= 13 && i <= 15)
+      add_metric(flush_blocks[1], opinfo);
+    if (i >= 16 && i <= 24)
+      add_metric(flush_blocks[2], opinfo);
+    if (i >= 25 && i <= 26)
+      add_metric(flush_blocks[3], opinfo);
+    if (i >= 27 && i <= 29)
+      add_metric(flush_blocks[4], opinfo);
+    if (i >= 28 && i <= 29)
+      add_metric(flush_blocks[5], opinfo);
+    if (i >= 30)
+      add_metric(flush_blocks[6], opinfo);
+  }
+  Write(FastMeleeDisplayList,
+        {power_pc, js.blockStart, clean, dirty_prefix, ready_suffix, flush_prefix, tail_metric,
+         flush_blocks});
+  s_melee_display_list_compiles.fetch_add(1, std::memory_order_relaxed);
+  return true;
+}

+      0x3bc30000, 0x80ada508, 0x800504f0, 0x28000000, 0x41820008, 0x4bffbf4d,
+      0x806da508, 0x80030000, 0x28000000, 0x40820008, 0x4bffc0a1, 0x38000040,
+      0x3c60cc01, 0x98038000, 0x93c38000, 0x93e38000, 0x8001001c, 0x83e10014,

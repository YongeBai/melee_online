diff --git a/Source/Core/Common/BrowserCopyBytes.h b/Source/Core/Common/BrowserCopyBytes.h
new file mode 100644
index 0000000000..8dfccb340b
--- /dev/null
+++ b/Source/Core/Common/BrowserCopyBytes.h
@@ -0,0 +1,40 @@
+// Private snapshot copies occur with emulation paused and disjoint buffers.
+#pragma once
+#include <cstddef>
+#include <cstring>
+#ifdef __wasm_simd128__
+#include <wasm_simd128.h>
+#endif
+namespace DolphinWeb {
+inline void CopySnapshotBytes(void* destination, const void* source, std::size_t bytes)
+{
+#ifdef __wasm_simd128__
+  // Volatile packed vector accesses preserve explicit SIMD transfers rather
+  // than folding the loop back into shared-memory memory.copy.
+  struct __attribute__((packed, may_alias)) Vector { v128_t value; };
+  auto* out = static_cast<unsigned char*>(destination);
+  auto* in = static_cast<const unsigned char*>(source);
+  while (bytes >= 64)
+  {
+    const auto a = reinterpret_cast<const volatile Vector*>(in)->value;
+    const auto b = reinterpret_cast<const volatile Vector*>(in+16)->value;
+    const auto c = reinterpret_cast<const volatile Vector*>(in+32)->value;
+    const auto d = reinterpret_cast<const volatile Vector*>(in+48)->value;
+    reinterpret_cast<volatile Vector*>(out)->value = a;
+    reinterpret_cast<volatile Vector*>(out+16)->value = b;
+    reinterpret_cast<volatile Vector*>(out+32)->value = c;
+    reinterpret_cast<volatile Vector*>(out+48)->value = d;
+    in += 64; out += 64; bytes -= 64;
+  }
+  while (bytes >= 16)
+  {
+    reinterpret_cast<volatile Vector*>(out)->value =
+        reinterpret_cast<const volatile Vector*>(in)->value;
+    in += 16; out += 16; bytes -= 16;
+  }
+  while (bytes--) *out++ = *in++;
+#else
+  std::memcpy(destination, source, bytes);
+#endif
+}
+}
diff --git a/Source/Core/Common/BrowserDispatchProfile.h b/Source/Core/Common/BrowserDispatchProfile.h
new file mode 100644
index 0000000000..45ffeb9007
--- /dev/null
+++ b/Source/Core/Common/BrowserDispatchProfile.h
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <sstream>
+#include <vector>
+
+// Host diagnostics only. CPU-thread ownership is required for reset/report.
+// Production dispatch has no sampling instructions; the profiled dispatcher
+// calls the identical compiled blocks and keeps all normal timing boundaries.
+namespace DolphinWeb::DispatchProfile
+{
+inline std::atomic<bool> enabled{false};
+inline std::uint32_t sequence = 0;
+struct Entry { std::uint32_t pc = 0; std::uint64_t count = 0; double us = 0; };
+inline std::array<Entry, 16384> entries{};
+inline std::uint64_t samples = 0, collisions = 0;
+inline double total_us = 0;
+inline std::uint32_t current_pc = 0;
+inline std::chrono::steady_clock::time_point start;
+
+inline void Reset()
+{
+  sequence = 0; entries = {}; samples = 0; collisions = 0; total_us = 0;
+}
+inline void Begin(std::uint32_t pc)
+{
+  current_pc = pc;
+  start = std::chrono::steady_clock::now();
+}
+inline void End()
+{
+  const double us = std::chrono::duration<double, std::micro>(
+      std::chrono::steady_clock::now() - start).count();
+  ++samples; total_us += us;
+  const auto slot = ((current_pc >> 2) * 2654435761u) & (entries.size() - 1);
+  for (std::size_t probe = 0; probe < 16; ++probe)
+  {
+    auto& entry = entries[(slot + probe) & (entries.size() - 1)];
+    if (entry.count && entry.pc != current_pc) continue;
+    entry.pc = current_pc; ++entry.count; entry.us += us; return;
+  }
+  ++collisions;
+}
+inline std::string Report()
+{
+  std::vector<Entry> hot;
+  for (const auto& entry : entries) if (entry.count) hot.push_back(entry);
+  std::sort(hot.begin(), hot.end(), [](const auto& a, const auto& b) { return a.us > b.us; });
+  const auto size = std::min<std::size_t>(hot.size(), 256);
+  std::ostringstream out;
+  out << "{\"enabled\":" << (enabled.load(std::memory_order_relaxed) ? "true" : "false")
+      << ",\"sampleEvery\":1024,\"samples\":" << samples << ",\"sampledUs\":" << total_us
+      << ",\"collisions\":" << collisions << ",\"uniqueSampledBlocks\":" << hot.size()
+      << ",\"reportedBlocks\":" << size << ",\"blocks\":[";
+  for (std::size_t i = 0; i < size; ++i)
+  {
+    if (i) out << ',';
+    out << "{\"pc\":" << hot[i].pc << ",\"samples\":" << hot[i].count
+        << ",\"sampledUs\":" << hot[i].us << '}';
+  }
+  out << "]}";
+  return out.str();
+}
+}
diff --git a/Source/Core/Common/BrowserProfile.h b/Source/Core/Common/BrowserProfile.h
new file mode 100644
index 0000000000..88e79bf3d9
--- /dev/null
+++ b/Source/Core/Common/BrowserProfile.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+#ifndef DOLPHIN_WEB_BROWSER_PROFILE
+#define DOLPHIN_WEB_BROWSER_PROFILE 1
+#endif
+
+namespace DolphinWeb::BrowserProfile
+{
+enum class Stage { CpuAdvance, CpuExecute, GlDraw, GlUniform, GlCompile, GlPresent, CpuGpuSync, CpuGpuDecode, CpuVideoWait, CpuChainSample, CpuPartialSample, CpuCallbackSample, CpuIdleSample, CpuFpHelperSample, CpuMemoryHelperSample, CpuSystemHelperSample, CpuInterpreterHelperSample, CpuMemoryReadSample, CpuMemoryWriteSample, CpuFifoWriteSample, CpuBranchCallbackSample, CpuEndCallbackSample, CpuGuestInterpretSample, CpuGatherSample, CpuGatherCopySample, CpuBurstSample, CoreEventVi, CoreEventDsp, CoreEventAudioDma, CoreEventGpuSleep, CoreEventGpuSync, CoreEventDecrementer, CoreEventPatch, CoreEventDvd, CoreEventOther, CoreEventWait, Count };
+constexpr std::array<const char*, static_cast<std::size_t>(Stage::Count)> names{
+    "cpuAdvance", "cpuExecute", "glDraw", "glUniform", "glCompile", "glPresent",
+    "cpuGpuSync", "cpuGpuDecode", "cpuVideoWait",
+    "cpuChainSample1024", "cpuPartialSample1024", "cpuCallbackSample1024", "cpuIdleSample1024", "cpuFpHelperSample1024", "cpuMemoryHelperSample1024", "cpuSystemHelperSample1024", "cpuInterpreterHelperSample1024", "cpuMemoryReadSample1024", "cpuMemoryWriteSample1024", "cpuFifoWriteSample1024", "cpuBranchCallbackSample1024", "cpuEndCallbackSample1024", "cpuGuestInterpretSample1024", "cpuGatherSample1024", "cpuGatherCopySample1024", "cpuBurstSample1024", "coreEventVi", "coreEventDsp", "coreEventAudioDma", "coreEventGpuSleep", "coreEventGpuSync", "coreEventDecrementer", "coreEventPatch", "coreEventDvd", "coreEventOther", "coreEventWait"};
+struct Counter
+{
+  std::atomic<std::uint64_t> count{0};
+  std::atomic<std::uint64_t> total_us{0};
+  std::atomic<std::uint64_t> max_us{0};
+};
+#if DOLPHIN_WEB_BROWSER_PROFILE
+inline std::atomic<bool> enabled{false};
+#else
+// Match the tiny portion of std::atomic<bool>'s interface used by the core so
+// release translation units can constant-fold every profiling guard away.
+struct DisabledFlag
+{
+  constexpr bool load(std::memory_order = std::memory_order_seq_cst) const { return false; }
+  constexpr void store(bool, std::memory_order = std::memory_order_seq_cst) const {}
+};
+inline constexpr DisabledFlag enabled{};
+#endif
+inline std::array<Counter, static_cast<std::size_t>(Stage::Count)> counters;
+
+inline void Record(Stage stage, std::uint64_t us)
+{
+#if DOLPHIN_WEB_BROWSER_PROFILE
+  if (!enabled.load(std::memory_order_relaxed))
+    return;
+  auto& counter = counters[static_cast<std::size_t>(stage)];
+  counter.count.fetch_add(1, std::memory_order_relaxed);
+  counter.total_us.fetch_add(us, std::memory_order_relaxed);
+  auto old = counter.max_us.load(std::memory_order_relaxed);
+  while (us > old && !counter.max_us.compare_exchange_weak(old, us, std::memory_order_relaxed)) {}
+#else
+  (void)stage;
+  (void)us;
+#endif
+}
+
+// CPU wall time of GL calls, not GPU execution time. Nested scopes overlap.
+class Scope
+{
+public:
+#if DOLPHIN_WEB_BROWSER_PROFILE
+  explicit Scope(Stage stage) : m_stage(stage), m_active(enabled.load(std::memory_order_relaxed)),
+    m_start(m_active ? Clock::now() : Clock::time_point{}) {}
+  ~Scope()
+  {
+    if (m_active)
+      Record(m_stage, std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - m_start).count());
+  }
+private:
+  using Clock = std::chrono::steady_clock;
+  Stage m_stage;
+  bool m_active;
+  Clock::time_point m_start;
+#else
+  explicit constexpr Scope(Stage) {}
+#endif
+};
+// CPU-thread-only sampling. These totals are raw sampled microseconds, not
+// complete wall time. Multiply by 1024 for an estimate; nested helpers overlap
+// their containing chains. Timing and bookkeeping overhead remain in samples.
+inline std::array<std::uint32_t, static_cast<std::size_t>(Stage::Count)> sample_sequences{};
+class SampleScope
+{
+public:
+#if DOLPHIN_WEB_BROWSER_PROFILE
+  explicit SampleScope(Stage stage, bool active) : m_stage(stage),
+    m_active(active && ((++sample_sequences[static_cast<std::size_t>(stage)] & 1023u) == 0)),
+    m_start(m_active ? Clock::now() : Clock::time_point{}) {}
+  explicit SampleScope(Stage stage) : SampleScope(stage, enabled.load(std::memory_order_relaxed)) {}
+  ~SampleScope() {
+    if (m_active) Record(m_stage,
+      std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - m_start).count());
+  }
+private:
+  using Clock = std::chrono::steady_clock;
+  Stage m_stage;
+  bool m_active;
+  Clock::time_point m_start;
+#else
+  explicit constexpr SampleScope(Stage, bool) {}
+  explicit constexpr SampleScope(Stage) {}
+#endif
+};
+}  // namespace DolphinWeb::BrowserProfile

+  std::array<u32, 3> clean{};
+  std::array<u32, 3> dirty_prefix{};
+  std::array<u32, 3> ready_suffix{};
+  std::array<u32, 3> flush_prefix{};
+  std::array<u32, 3> tail_metric{};
+  std::array<std::array<u32, 3>, 7> flush_blocks{};
+  const auto add_metric = [](std::array<u32, 3>& metric, const GekkoOPInfo& opinfo) {
+    metric[0] += opinfo.num_cycles;
+    if ((opinfo.flags & FL_LOADSTORE) != 0)
+      ++metric[1];
+    if ((opinfo.flags & FL_USE_FPU) != 0)
+      ++metric[2];
+  };

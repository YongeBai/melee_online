+    report += fmt::format(R"({{"name":"{}","startA":{},"startB":{},"bytesA":{},"bytesB":{},"differentBytes":{},"unmatchedBytes":{},"firstRelativeOffset":{},"rangeCount":{},"rangesTruncated":{},"fieldsComplete":{},"ranges":[)",
+      sa.name, start_a, start_b, size_a, size_b, diff.different_bytes, diff.unmatched_bytes,
+      diff.ranges.empty() ? -1 : static_cast<int>(diff.ranges.front().offset), diff.range_count,
+      diff.range_count > diff.ranges.size(), browser_state_fields[a].complete && browser_state_fields[b].complete);
+    const auto fieldAt = [](const BrowserStateFields& fields, std::size_t offset, std::size_t bytes,
+                            std::size_t section_start) {
+      for (const auto& field : fields.fields)
+      {
+        if (offset >= field.start && offset < field.end)
+          return fmt::format(R"({{"name":"{}","startRelativeOffset":{},"bytes":{},"containsWholeRange":{}}})",
+            field.name, field.start - section_start, field.end - field.start, bytes <= field.end - offset);
+      }
+      return std::string("null");
+    };
+    bool comma = false;
+    for (const auto& range : diff.ranges)
+    {
+      if (comma) report += ",";
+      comma = true;
+      const auto short_hex = [](const u8* data, std::size_t length) {
+        std::string hex;
+        if (length > 16)
+          return hex;
+        hex.reserve(length * 2);
+        for (std::size_t i = 0; i < length; ++i)
+          hex += fmt::format("{:02x}", data[i]);
+        return hex;
+      };
+      const std::size_t context_offset = range.offset > 8 ? range.offset - 8 : 0;
+      const std::size_t context_length =
+          std::min<std::size_t>(24, std::min(size_a, size_b) - context_offset);
+      report += fmt::format(R"({{"offset":{},"bytes":{},"hexA":"{}","hexB":"{}","contextOffset":{},"contextA":"{}","contextB":"{}","fieldA":{},"fieldB":{}}})",
+        range.offset, range.length,
+        short_hex(x + start_a + range.offset, range.length),
+        short_hex(y + start_b + range.offset, range.length),
+        context_offset,
+        short_hex(x + start_a + context_offset, std::min<std::size_t>(16, context_length)),
+        short_hex(y + start_b + context_offset, std::min<std::size_t>(16, context_length)),
+        fieldAt(browser_state_fields[a], start_a + range.offset, range.length, start_a),
+        fieldAt(browser_state_fields[b], start_b + range.offset, range.length, start_b));
+    }
+    report += "]}";
+    start_a = sa.end;
+    start_b = sb.end;
+  }
+  return report + "]}";
+}
+std::string BrowserCaptureProfile(unsigned slot)
+{
+  if (slot >= browser_states.size()) return "{}";
+  std::string result = fmt::format(R"({{"measureUs":{},"allocateUs":{},"gpuTextureBytes":{},"writeSections":[)",
+      browser_measure_us[slot], browser_allocate_us[slot], g_texture_cache ? g_texture_cache->BrowserTextureBytes() : 0);
+  u64 previous = 0;
+  bool comma = false;
+  for (const auto& section : browser_state_sections[slot])
+  {
+    if (comma) result += ",";
+    result += fmt::format(R"({{"name":"{}","writeUs":{}}})", section.name, section.write_us - previous);
+    previous = section.write_us;
+    comma = true;
+  }
+  return result + "]}";
+}
+bool BrowserRelease(Core::System& system, unsigned slot)
+{
+  if (slot >= browser_states.size()) return false;
+  browser_state_sizes[slot] = 0;
+  browser_states_gpu[slot] = false;
+  browser_states[slot].reset();
+  browser_state_sections[slot].clear();
+  browser_state_fields[slot] = {};
+  if (g_texture_cache)
+  {
+    auto release = [slot] { g_texture_cache->BrowserReleaseState(slot); };
+    if (system.IsDualCoreMode()) AsyncRequests::GetInstance()->PushBlockingEvent(release);
+    else release();
+  }
+  return true;
+}
+void BrowserClear()
+{
+  auto& system = Core::System::GetInstance();
+  if (g_texture_cache && Core::IsRunning(system))
+  {
+    const Core::CPUThreadGuard guard(system);
+    auto clear = [] { if (g_texture_cache) g_texture_cache->BrowserClearStates(); };
+    if (system.IsDualCoreMode()) AsyncRequests::GetInstance()->PushBlockingEvent(clear);
+    else clear();
+  }
+  browser_states_gpu.fill(false);
+  for (auto& state : browser_states) state.reset();
+  browser_state_sizes.fill(0);
+  for (auto& fields : browser_state_fields) fields = {};
+}

+s32 CachedInterpreter::FastMeleeIdlePollLoop(PowerPC::PowerPCState& ppc_state,
+                                             const MeleeIdlePollLoopOperands& operands)
+{
+  const auto& [power_pc, current_pc, next_pc, instruction_cycles_per_iteration,
+               instruction_loadstores_per_iteration] = operands;
+  (void)power_pc;
+  constexpr s32 fallback_size = sizeof(AnyCallback) + sizeof(operands);
+
+  const u32 pending_exceptions =
+      ppc_state.Exceptions &
+      (EXCEPTION_EXTERNAL_INT | EXCEPTION_PERFORMANCE_MONITOR | EXCEPTION_DECREMENTER);
+  if (current_pc != MELEE_IDLE_POLL_LOOP_PC || next_pc != MELEE_IDLE_POLL_LOOP_END_PC ||
+      instruction_cycles_per_iteration == 0 || ppc_state.msr.LE || ppc_state.msr.PR ||
+      pending_exceptions != 0 || !IsOsInterruptModeVerified(OS_INTERRUPT_DISABLE) ||
+      !IsOsInterruptModeVerified(OS_INTERRUPT_RESTORE) || !VerifyMeleeServicePollFunction() ||
+      !VerifyMeleeInputPollNoChangeFunction())
+  {
+    ++s_fast_melee_idle_poll_loop_rejects;
+    return fallback_size;
+  }
+
+  // A real loop exit can happen in the guarded fallback, so a lifetime
+  // "no fast exits" threshold permanently disabled this helper after boot.
+  // Periodically run the original instructions instead. Runtime guards and
+  // the per-downcount / 256-iteration bounds remain in force on every batch.
+  if (s_fast_melee_idle_batches_since_fallback++ >= MELEE_IDLE_POLL_LOOP_FALLBACK_INTERVAL)
+  {
+    s_fast_melee_idle_batches_since_fallback = 0;
+    ++s_fast_melee_idle_poll_loop_throttles;
+    return fallback_size;
+  }
+
+  const u32 restore_cycles =
+      (ppc_state.msr.Hex & MSR_EE_MASK) != 0 ? OS_INTERRUPT_RESTORE_ENABLE_CYCLES :
+                                               OS_INTERRUPT_RESTORE_DISABLE_CYCLES;
+  const u32 cycles_per_iteration = instruction_cycles_per_iteration +
+                                   s_fast_melee_service_poll_cycles +
+                                   s_fast_melee_input_poll_cycles + restore_cycles;
+  const u32 loadstores_per_iteration = instruction_loadstores_per_iteration +
+                                       s_fast_melee_service_poll_loadstores +
+                                       s_fast_melee_input_poll_loadstores;
+  if (cycles_per_iteration == 0)
+  {
+    ++s_fast_melee_idle_poll_loop_rejects;
+    return fallback_size;
+  }
+
+  const u32 max_by_downcount =
+      ppc_state.downcount > 0 ?
+          std::max<u32>(1, static_cast<u32>(ppc_state.downcount) / cycles_per_iteration) :
+          1;
+  const u32 max_iterations = std::min(max_by_downcount, MELEE_IDLE_POLL_LOOP_MAX_BATCH);
+
+  // In deterministic mode these SDK globals are updated by CPU-thread events.
+  // This helper neither executes an event nor writes RAM inside a batch, and
+  // retains its existing downcount boundary. Limit the opt-in hoist to the
+  // static idle status (no dynamically addressed status object).
+  u32 idle_status_pointer = 0;
+  const bool hoist_idle_checks = DolphinWebFeatureEnabled(1u << 31) &&
+      Core::System::GetInstance().GetFifo().UseDeterministicGPUThread() &&
+      ppc_state.gpr[13] >= 0x804c0000 && ppc_state.gpr[13] < 0x804e0000 &&
+      TryReadFastRamU32Address(ppc_state.gpr[13] - 0x4408, &idle_status_pointer) &&
+      (idle_status_pointer == 0 || idle_status_pointer == MELEE_STATUS_IDLE_POINTER);
+
+  u32 iterations = 0;
+  u32 final_status = 0;
+  bool exit_loop = false;
+  bool guard_failed = false;
+  for (; iterations < max_iterations; ++iterations)
+  {
+    u32 si_state = 0;
+    u32 si_pending = 0;
+    const std::optional<u32> raw_status = TryReadFastMeleeStatusResult(ppc_state);
+    const u32 mapped_status = raw_status ? MapFastMeleeStatusDispatchResult(*raw_status) : 0;
+    const bool status_dispatch_returns_early =
+        raw_status && (mapped_status == 0xffffffff || mapped_status == 5);
+    if (!status_dispatch_returns_early ||
+        !TryReadFastMeleeSiPollWords(&si_state, &si_pending) || si_state != 0 ||
+        si_pending != 0)
+    {
+      guard_failed = true;
+      break;
+    }
+
+    u32 old_high = 0;
+    u32 old_low = 0;
+    u32 new_high = 0;
+    u32 new_low = 0;
+    u32 status = 0;
+    if (!TryReadFastMeleeInputPollNoChangeWords(&old_high, &old_low, &new_high, &new_low) ||
+        old_high != new_high || old_low != new_low ||
+        !TryReadFastMeleeInputStatusByte(ppc_state, &status))
+    {
+      guard_failed = true;
+      break;
+    }
+
+    final_status = status & 0xff;
+    if (final_status != 0)
+    {
+      ++iterations;
+      exit_loop = true;
+      break;
+    }
+    if (hoist_idle_checks)
+    {
+      s_fast_melee_idle_hoisted_iterations = SaturatingAddU32(
+          s_fast_melee_idle_hoisted_iterations, max_iterations - 1);
+      iterations = max_iterations;
+      break;
+    }
+  }
+
+  if (iterations == 0)
+  {
+    ++s_fast_melee_idle_poll_loop_fallbacks;
+    return fallback_size;
+  }
+
+  const u32 cycles = cycles_per_iteration * iterations;
+  const u32 loadstores = loadstores_per_iteration * iterations;
+  ppc_state.gpr[0] = current_pc + sizeof(u32);
+  ppc_state.gpr[3] = final_status;
+  ppc_state.gpr[27] = final_status;
+  LR(ppc_state) = current_pc + 2 * sizeof(u32);
+  FastUpdateCR0(ppc_state, final_status);
+  ppc_state.npc = exit_loop ? next_pc : current_pc;
+  ppc_state.pc = ppc_state.npc;
+  ppc_state.downcount -= static_cast<int>(cycles);
+  UpdatePerformanceMonitorIfNeeded(cycles, loadstores, 0, ppc_state);
+
+  ++s_fast_melee_idle_poll_loop_blocks;
+  s_fast_melee_idle_poll_loop_iterations =
+      SaturatingAddU32(s_fast_melee_idle_poll_loop_iterations, iterations);
+  s_fast_melee_service_poll_inline_ops =
+      SaturatingAddU32(s_fast_melee_service_poll_inline_ops, iterations);
+  s_fast_melee_input_poll_inline_ops =
+      SaturatingAddU32(s_fast_melee_input_poll_inline_ops, iterations);
+  if (exit_loop)
+    ++s_fast_melee_idle_poll_loop_exits;
+  if (guard_failed)
+    ++s_fast_melee_idle_poll_loop_fallbacks;
+  return 0;
+}
+
+static std::array<double, 2> MeleeMatrixMulS0(PowerPC::PowerPCState& ppc_state,
+                                             const std::array<double, 2>& a,
+                                             const std::array<double, 2>& c)
+{
+  const double c0 = Force25Bit(c[0]);
+  const float ps0 = ForceSingle(ppc_state.fpscr, NI_mul(ppc_state, a[0], c0).value);
+  const float ps1 = ForceSingle(ppc_state.fpscr, NI_mul(ppc_state, a[1], c0).value);
+  ppc_state.UpdateFPRFSingle(ps0);
+  return {ps0, ps1};
+}
+
+static std::array<double, 2> MeleeMatrixMaddS(PowerPC::PowerPCState& ppc_state,
+                                              const std::array<double, 2>& a,
+                                              const std::array<double, 2>& b,
+                                              double c)
+{
+  const float ps0 = ForceSingle(
+      ppc_state.fpscr, NI_madd<true>(ppc_state, a[0], c, b[0]).value);
+  const float ps1 = ForceSingle(
+      ppc_state.fpscr, NI_madd<true>(ppc_state, a[1], c, b[1]).value);
+  ppc_state.UpdateFPRFSingle(ps0);
+  return {ps0, ps1};
+}
+
+s32 CachedInterpreter::FastMeleeMatrixConcat(PowerPC::PowerPCState& ppc_state,
+                                              const MeleeMatrixConcatOperands& operands)
+{
+  const auto& [power_pc, current_pc, cycles, loadstores, fp_inst] = operands;
+  (void)power_pc;
+  auto& memory = Core::System::GetInstance().GetMemory();
+  u8* const ram = memory.GetRAM();
+  const u32 ram_size = memory.GetRamSizeReal();
+  const u32 old_sp = ppc_state.gpr[1];
+  const u32 new_sp = old_sp - 64;
+  u32 stack_offset = 0;
+  u32 a_offset = 0;
+  u32 b_offset = 0;
+  u32 out_offset = 0;
+  u32 unit_offset = 0;
+  const auto fallback = [&](std::atomic<u32>& reason) {
+    reason.fetch_add(1, std::memory_order_relaxed);
+    s_melee_matrix_fast_fallbacks.fetch_add(1, std::memory_order_relaxed);
+    return sizeof(AnyCallback) + sizeof(operands);
+  };
+  if (!ppc_state.msr.FP)
+    return fallback(s_melee_matrix_fast_fallback_fp);
+  if (!TryFastAlignedRamOffset(ppc_state, ram, ram_size, new_sp, 48, &stack_offset))
+    return fallback(s_melee_matrix_fast_fallback_stack);
+  if (!TryFastAlignedRamOffset(ppc_state, ram, ram_size, ppc_state.gpr[3], 48, &a_offset))
+    return fallback(s_melee_matrix_fast_fallback_a);
+  if (!TryFastAlignedRamOffset(ppc_state, ram, ram_size, ppc_state.gpr[4], 48, &b_offset))
+    return fallback(s_melee_matrix_fast_fallback_b);
+  if (!TryFastAlignedRamOffset(ppc_state, ram, ram_size, ppc_state.gpr[5], 48, &out_offset))
+    return fallback(s_melee_matrix_fast_fallback_out);
+  if (!TryFastAlignedRamOffset(ppc_state, ram, ram_size, 0x804d5c00, 8, &unit_offset))
+  {
+    return fallback(s_melee_matrix_fast_fallback_unit);
+  }
+
+  const auto load_pair = [&](u32 offset) {
+    return std::array<double, 2>{
+        std::bit_cast<double>(ConvertToDouble(ReadRamU32BE(ram, offset))),
+        std::bit_cast<double>(ConvertToDouble(ReadRamU32BE(ram, offset + 4)))};
+  };
+  const auto store_pair = [&](u32 offset, const std::array<double, 2>& value) {
+    WriteRamU32BE(ram, offset, ConvertToSingleFTZ(std::bit_cast<u64>(value[0])));
+    WriteRamU32BE(ram, offset + 4, ConvertToSingleFTZ(std::bit_cast<u64>(value[1])));
+  };
+  const auto write_u64 = [&](u32 offset, u64 value) {
+    WriteRamU32BE(ram, offset, static_cast<u32>(value >> 32));
+    WriteRamU32BE(ram, offset + 4, static_cast<u32>(value));
+  };
+
+  // Preserve the ABI-visible scratch writes made by stwu/stfd even though the
+  // optimized routine does not need a host stack frame.
+  WriteRamU32BE(ram, stack_offset, old_sp);
+  write_u64(stack_offset + 8, ppc_state.ps[14].PS0AsU64());
+  write_u64(stack_offset + 16, ppc_state.ps[15].PS0AsU64());
+  write_u64(stack_offset + 40, ppc_state.ps[31].PS0AsU64());
+
+  auto f0 = load_pair(a_offset);
+  auto f6 = load_pair(b_offset);
+  auto f7 = load_pair(b_offset + 8);
+  auto f8 = load_pair(b_offset + 16);
+  auto f12 = MeleeMatrixMulS0(ppc_state, f6, f0);
+  auto f2 = load_pair(a_offset + 16);
+  auto f13 = MeleeMatrixMulS0(ppc_state, f7, f0);
+  const auto f31 = load_pair(unit_offset);
+  auto f14 = MeleeMatrixMulS0(ppc_state, f6, f2);
+  auto f9 = load_pair(b_offset + 24);
+  auto f15 = MeleeMatrixMulS0(ppc_state, f7, f2);
+  const auto f1 = load_pair(a_offset + 8);
+  f12 = MeleeMatrixMaddS(ppc_state, f8, f12, f0[1]);
+  const auto f3 = load_pair(a_offset + 24);
+  f14 = MeleeMatrixMaddS(ppc_state, f8, f14, f2[1]);
+  const auto f10 = load_pair(b_offset + 32);
+  f13 = MeleeMatrixMaddS(ppc_state, f9, f13, f0[1]);
+  const auto f11 = load_pair(b_offset + 40);
+  f15 = MeleeMatrixMaddS(ppc_state, f9, f15, f2[1]);
+  const auto f4 = load_pair(a_offset + 32);
+  const auto f5 = load_pair(a_offset + 40);
+  f12 = MeleeMatrixMaddS(ppc_state, f10, f12, f1[0]);
+  f13 = MeleeMatrixMaddS(ppc_state, f11, f13, f1[0]);
+  f14 = MeleeMatrixMaddS(ppc_state, f10, f14, f3[0]);
+  f15 = MeleeMatrixMaddS(ppc_state, f11, f15, f3[0]);
+  f2 = MeleeMatrixMulS0(ppc_state, f6, f4);
+  f13 = MeleeMatrixMaddS(ppc_state, f31, f13, f1[1]);
+  f0 = MeleeMatrixMulS0(ppc_state, f7, f4);
+  f15 = MeleeMatrixMaddS(ppc_state, f31, f15, f3[1]);
+  f2 = MeleeMatrixMaddS(ppc_state, f8, f2, f4[1]);
+  f0 = MeleeMatrixMaddS(ppc_state, f9, f0, f4[1]);
+  f2 = MeleeMatrixMaddS(ppc_state, f10, f2, f5[0]);
+  f0 = MeleeMatrixMaddS(ppc_state, f11, f0, f5[0]);
+  f0 = MeleeMatrixMaddS(ppc_state, f31, f0, f5[1]);
+
+  store_pair(out_offset, f12);
+  store_pair(out_offset + 8, f13);
+  store_pair(out_offset + 16, f14);
+  store_pair(out_offset + 24, f15);
+  store_pair(out_offset + 32, f2);
+  store_pair(out_offset + 40, f0);

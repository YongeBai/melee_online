+s32 CachedInterpreter::FastMeleeParseFloat(
+    PowerPC::PowerPCState& ppc_state, const MeleeParseFloatOperands& operands)
+{
+  const auto& [power_pc, current_pc, paths] = operands;
+  (void)power_pc;
+  (void)current_pc;
+  constexpr s32 fallback_size = sizeof(AnyCallback) + sizeof(operands);
+  // Share the existing animation-continuation runtime gate so replay can
+  // compare this leaf without recompiling the surrounding generated blocks.
+  if (!s_dolphin_web_melee_anim_callback_fast.load(std::memory_order_relaxed))
+    return fallback_size;
+
+  auto& memory = Core::System::GetInstance().GetMemory();
+  u8* const ram = memory.GetRAM();
+  const u32 ram_size = memory.GetRamSizeReal();
+  const u32 pointer_address = ppc_state.gpr[3];
+  const u32 old_sp = ppc_state.gpr[1];
+  const u32 new_sp = old_sp - 32;
+  u32 pointer_offset = 0, stack_offset = 0;
+  if (!ppc_state.msr.FP || ppc_state.msr.LE || pointer_address == 0 ||
+      !TryFastAlignedRamOffset(ppc_state, ram, ram_size, pointer_address, 4,
+                               &pointer_offset) ||
+      !TryFastAlignedRamOffset(ppc_state, ram, ram_size, new_sp, 32,
+                               &stack_offset))
+  {
+    return fallback_size;
+  }
+
+  const u32 data_address = ReadRamU32BE(ram, pointer_offset);
+  const u32 frac = ppc_state.gpr[4] & 0xff;
+  u32 path = 0;
+  u32 bytes = 4;
+  if (frac != 0)
+  {
+    switch (frac & 0xe0)
+    {
+    case 0x60:
+      path = 1;
+      bytes = 1;
+      break;
+    case 0x80:
+      path = 2;
+      bytes = 1;
+      break;
+    case 0x20:
+      path = 3;
+      bytes = 2;
+      break;
+    case 0x40:
+      path = 4;
+      bytes = 2;
+      break;
+    default:
+      return fallback_size;
+    }
+  }
+
+  const u32 data_offset = data_address & 0x3fffffff;
+  if (ram == nullptr || data_offset >= ram_size || ram_size - data_offset < bytes)
+    return fallback_size;
+  const auto overlaps = [](u32 a, u32 as, u32 b, u32 bs) {
+    return a < b + bs && b < a + as;
+  };
+  if (overlaps(pointer_offset, 4, stack_offset, 32) ||
+      overlaps(pointer_offset, 4, data_offset, bytes) ||
+      overlaps(stack_offset, 32, data_offset, bytes))
+  {
+    return fallback_size;
+  }
+
+  u32 magic_offset = 0;
+  u32 signed_magic_offset = 0;
+  if (path != 0)
+  {
+    const u32 conversion_magic_address =
+        ppc_state.gpr[2] - (path == 2 ? 5376 : 5384);
+    if (!TryFastAlignedRamOffset(ppc_state, ram, ram_size, conversion_magic_address, 8,
+                                 &magic_offset) ||
+        !TryFastAlignedRamOffset(ppc_state, ram, ram_size, ppc_state.gpr[2] - 5384, 8,
+                                 &signed_magic_offset) ||
+        overlaps(stack_offset, 32, magic_offset, 8) ||
+        overlaps(stack_offset, 32, signed_magic_offset, 8) ||
+        overlaps(pointer_offset, 4, magic_offset, 8) ||
+        overlaps(pointer_offset, 4, signed_magic_offset, 8) ||
+        overlaps(data_offset, bytes, magic_offset, 8) ||
+        overlaps(data_offset, bytes, signed_magic_offset, 8))
+    {
+      return fallback_size;
+    }
+  }
+
+  const auto& metric = paths[path];
+  if (ppc_state.downcount <= 0 ||
+      static_cast<u64>(ppc_state.downcount) <= metric[0])
+  {
+    return fallback_size;
+  }
+
+  // stwu r1,-32(r1), including the back-chain word observable in snapshots.
+  WriteRamU32BE(ram, stack_offset, old_sp);
+  ppc_state.gpr[1] = new_sp;
+  FastUpdateCR0(ppc_state, 0);
+
+  if (path == 0)
+  {
+    const u32 b0 = ram[data_offset];
+    const u32 b1 = ram[data_offset + 1];
+    const u32 b2 = ram[data_offset + 2];
+    const u32 b3 = ram[data_offset + 3];
+    const u32 value_bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
+    WriteRamU32BE(ram, pointer_offset, data_address + 4);
+    WriteRamU32BE(ram, stack_offset + 16, value_bits);
+    ppc_state.gpr[4] = data_address + 3;
+    ppc_state.gpr[5] = b0 | (b1 << 8) | (b2 << 16);
+    ppc_state.gpr[0] = value_bits;
+    ppc_state.ps[1].Fill(ConvertToDouble(value_bits));
+  }
+  else
+  {
+    const u32 shift = frac & 0x1f;
+    const u32 denominator = 1u << shift;
+    u32 numerator = 0;
+    if (path == 1)
+    {
+      numerator = static_cast<u32>(static_cast<s32>(static_cast<s8>(ram[data_offset])));
+      ppc_state.gpr[6] = data_address;
+      ppc_state.gpr[5] = numerator;
+    }
+    else if (path == 2)
+    {
+      numerator = ram[data_offset];
+      ppc_state.gpr[6] = data_address;
+      ppc_state.gpr[5] = numerator;
+    }
+    else
+    {
+      const u32 high = ram[data_offset + 1];
+      const u32 low = ram[data_offset];
+      ppc_state.gpr[6] = path == 3 ?
+                             static_cast<u32>(static_cast<s32>(static_cast<s8>(high))) :
+                             high;
+      numerator = path == 3 ?
+                      ((static_cast<u32>(static_cast<s32>(static_cast<s8>(high))) << 8) |
+                       low) :
+                      ((high << 8) | low);
+      ppc_state.gpr[5] = numerator;
+    }
+
+    WriteRamU32BE(ram, pointer_offset, data_address + bytes);
+    ppc_state.gpr[7] = denominator;
+    ppc_state.gpr[4] = 0x43300000;
+    const u32 numerator_low = path == 2 ? numerator : (numerator ^ 0x80000000);
+    WriteRamU32BE(ram, stack_offset + 24, 0x43300000);
+    WriteRamU32BE(ram, stack_offset + 28, numerator_low);
+    const u64 numerator_encoded =
+        (static_cast<u64>(0x43300000) << 32) | numerator_low;
+    const u64 numerator_magic_bits =
+        (static_cast<u64>(ReadRamU32BE(ram, magic_offset)) << 32) |
+        ReadRamU32BE(ram, magic_offset + 4);
+    const float numerator_value = ForceSingle(
+        ppc_state.fpscr,
+        NI_sub(ppc_state, std::bit_cast<double>(numerator_encoded),
+               std::bit_cast<double>(numerator_magic_bits)).value);
+    ppc_state.ps[2].Fill(numerator_value);
+    ppc_state.UpdateFPRFSingle(numerator_value);
+
+    const u32 denominator_low = denominator ^ 0x80000000;
+    WriteRamU32BE(ram, stack_offset + 28, denominator_low);
+    const u64 denominator_encoded =
+        (static_cast<u64>(0x43300000) << 32) | denominator_low;
+    const u64 signed_magic_bits =
+        (static_cast<u64>(ReadRamU32BE(ram, signed_magic_offset)) << 32) |
+        ReadRamU32BE(ram, signed_magic_offset + 4);
+    const float denominator_value = ForceSingle(
+        ppc_state.fpscr,
+        NI_sub(ppc_state, std::bit_cast<double>(denominator_encoded),
+               std::bit_cast<double>(signed_magic_bits)).value);
+    ppc_state.ps[0].Fill(denominator_value);
+    ppc_state.UpdateFPRFSingle(denominator_value);
+    const float result = ForceSingle(
+        ppc_state.fpscr,
+        NI_div(ppc_state, numerator_value, denominator_value).value);
+    ppc_state.ps[1].Fill(result);
+    ppc_state.UpdateFPRFSingle(result);
+    ppc_state.gpr[0] = 0x43300000;
+  }
+
+  ppc_state.gpr[1] = old_sp;
+  ppc_state.pc = LR(ppc_state) & ~3u;
+  ppc_state.npc = ppc_state.pc;
+  ppc_state.downcount -= static_cast<int>(metric[0]);
+  UpdatePerformanceMonitorIfNeeded(metric[0], metric[1], metric[2], ppc_state);
+  return 0;
+}
+
+s32 CachedInterpreter::FastMeleeAnimStateProbe(
+    PowerPC::PowerPCState& ppc_state, const MeleeAnimStateProbeOperands& operands)
+{
+  const auto& [power_pc, current_pc, prefix_cycles, prefix_loadstores, prefix_fp,
+               state4_cycles, state4_loadstores, state4_fp,
+               state5_cycles, state5_loadstores, state5_fp,
+               constant_less, constant_at_least, linear_cached,
+               linear_init_nonzero, linear_init_zero, callback_setup,
+               callback_return, jobj_update] = operands;
+  (void)power_pc;
+  (void)current_pc;
+  constexpr s32 fallback_size = sizeof(AnyCallback) + sizeof(operands);
+  // These counters made the optimized path publish several cross-thread
+  // atomics for every animated property.  Keep them for diagnostic runs, but
+  // let the existing lean-release switch remove that observer cost.  Read the
+  // switch once per callback so the lean path performs no atomic RMWs.
+  const bool publish_counters = !s_dolphin_web_lean_dispatch.load(std::memory_order_relaxed);
+  const auto count = [publish_counters](std::atomic<u32>& counter) {
+    if (publish_counters)
+      counter.fetch_add(1, std::memory_order_relaxed);
+  };
+  count(s_melee_anim_probe_runs);
+
+  auto& memory = Core::System::GetInstance().GetMemory();
+  u8* const ram = memory.GetRAM();
+  const u32 ram_size = memory.GetRamSizeReal();
+  u32 offset = 0, stack_offset = 0, zero_offset = 0, f31_offset = 0;
+  const u32 old_sp = ppc_state.gpr[1];
+  const u32 new_sp = old_sp - 168;
+  if (!ppc_state.msr.FP || ppc_state.msr.LE || ppc_state.gpr[3] == 0 ||
+      !TryFastAlignedRamOffset(ppc_state, ram, ram_size, ppc_state.gpr[3], 48, &offset) ||
+      !TryFastAlignedRamOffset(ppc_state, ram, ram_size, new_sp, 176, &stack_offset) ||
+      !TryFastAlignedRamOffset(ppc_state, ram, ram_size, ppc_state.gpr[2] - 5392, 4,
+                               &zero_offset) ||
+      !TryFastAlignedRamOffset(ppc_state, ram, ram_size, ppc_state.gpr[2] - 5376, 8,
+                               &f31_offset))
+  {
+    return fallback_size;
+  }
+  const auto overlaps = [](u32 a, u32 as, u32 b, u32 bs) {
+    return a < b + bs && b < a + as;
+  };
+  if (overlaps(offset, 48, stack_offset, 176) || overlaps(offset, 48, zero_offset, 4) ||
+      overlaps(offset, 48, f31_offset, 8) || overlaps(stack_offset, 176, zero_offset, 4) ||
+      overlaps(stack_offset, 176, f31_offset, 8))
+  {
+    return fallback_size;
+  }
+  count(s_melee_anim_probe_direct);
+
+  const u8 flags = ram[offset + 16];
+  const u32 state = flags & 0xf;
+  if (state < s_melee_anim_probe_states.size())
+    count(s_melee_anim_probe_states[state]);
+  const u32 op = ram[offset + 18];
+  if (op < s_melee_anim_probe_ops.size())
+    count(s_melee_anim_probe_ops[op]);
+  if (state != 4 && state != 5)
+    return fallback_size;
+
+  // The host continuation below only replaces constant and linear key
+  // interpolation.  Let spline, slope and key tracks remain in the generated
+  // guest WASM instead of paying for a C++ transition which ultimately rejoins
+  // the original FObjUpdateAnim body.  Keep this behind the experiment gate so
+  // the same compiled core can measure the crossing cost at one checkpoint.
+  if (s_dolphin_web_melee_anim_callback_fast.load(std::memory_order_relaxed) &&
+      op != 1 && op != 2)
+  {
+    return fallback_size;
+  }
+
+  const u32 fobj = ppc_state.gpr[3];
+  const u32 obj = ppc_state.gpr[4];
+  const u32 obj_update = ppc_state.gpr[5];
+  const u32 old_lr = LR(ppc_state);
+  std::array<u32, 6> old_gprs{};
+  for (u32 reg = 26; reg <= 31; ++reg)
+    old_gprs[reg - 26] = ppc_state.gpr[reg];
+  const u64 old_f29 = ppc_state.ps[29].PS0AsU64();
+  const u64 old_f30 = ppc_state.ps[30].PS0AsU64();
+  const u64 old_f31 = ppc_state.ps[31].PS0AsU64();
+  const u64 rate = ppc_state.ps[1].PS0AsU64();
+  const u32 time_bits = ReadRamU32BE(ram, offset + 28);
+  const double time = std::bit_cast<double>(ConvertToDouble(time_bits));
+
+  const auto write_u64 = [&](u32 target, u64 value) {
+    WriteRamU32BE(ram, target, static_cast<u32>(value >> 32));
+    WriteRamU32BE(ram, target + 4, static_cast<u32>(value));
+  };
+  WriteRamU32BE(ram, stack_offset + 172, old_lr);
+  WriteRamU32BE(ram, stack_offset, old_sp);
+  write_u64(stack_offset + 160, old_f31);
+  write_u64(stack_offset + 152, old_f30);
+  write_u64(stack_offset + 144, old_f29);
+  for (u32 reg = 26; reg <= 31; ++reg)
+    WriteRamU32BE(ram, stack_offset + 120 + (reg - 26) * 4, old_gprs[reg - 26]);
+
+  ppc_state.gpr[1] = new_sp;
+  ppc_state.ps[30].SetPS0(rate);
+  ppc_state.ps[29].Fill(ConvertToDouble(ReadRamU32BE(ram, zero_offset)));
+  ppc_state.gpr[31] = fobj;
+  ppc_state.gpr[30] = 0x80406350;
+  ppc_state.gpr[28] = obj;
+  ppc_state.gpr[27] = obj_update;
+  ppc_state.gpr[3] = state;
+  ppc_state.gpr[0] = flags;
+  LR(ppc_state) = 0x8036b074;
+
+  const FPResult sum = NI_add(ppc_state, time, ppc_state.ps[30].PS0AsDouble());
+  const float next_time = ForceSingle(ppc_state.fpscr, sum.value);
+  ppc_state.ps[0].Fill(next_time);
+  ppc_state.UpdateFPRFSingle(next_time);
+  WriteRamU32BE(ram, offset + 28, ConvertToSingle(ppc_state.ps[0].PS0AsU64()));
+
+  const u16 fterm = static_cast<u16>((ram[offset + 26] << 8) | ram[offset + 27]);
+  u32 cycles = prefix_cycles, loadstores = prefix_loadstores, fp = prefix_fp;
+  u32 target = 0x8036b090;
+  if (next_time >= 0.0f && next_time < static_cast<float>(fterm))
+  {
+    count(s_melee_anim_probe_common);
+    const bool callback = ppc_state.gpr[5] != 0 && (op != 6 || (flags & 0x80) != 0);
+    count(callback ? s_melee_anim_probe_callback : s_melee_anim_probe_no_callback);
+    ppc_state.ps[1].Fill(next_time);
+    const u64 f31 = (static_cast<u64>(ReadRamU32BE(ram, f31_offset)) << 32) |
+                    ReadRamU32BE(ram, f31_offset + 4);
+    ppc_state.ps[31].SetPS0(f31);
+    ppc_state.ps[30].Fill(ConvertToDouble(ReadRamU32BE(ram, zero_offset)));
+    ppc_state.gpr[29] = 0x43300000;
+    ppc_state.gpr[3] = 4;
+    FastUpdateCR0(ppc_state, 0);
+    if (state == 5)
+    {
+      ram[offset + 16] = static_cast<u8>((flags & 0xf0) | 4);
+      cycles = state5_cycles;
+      loadstores = state5_loadstores;
+      fp = state5_fp;
+    }
+    else
+    {
+      cycles = state4_cycles;
+      loadstores = state4_loadstores;
+      fp = state4_fp;
+    }
+    target = 0x8036b5f0;
+
+    // Recreate the exact FObjUpdateAnim frame, complete its overwhelmingly
+    // common constant/linear interpolation, and enter JObjUpdateFunc directly.
+    // Unsupported callbacks and exceptional floating-point states remain in
+    // the original guest routine.
+    const u32 inner_sp = new_sp - 56;
+    u32 inner_stack_offset = 0;
+    if ((op == 1 || op == 2) && obj_update == 0x8036fdc0 &&
+        ppc_state.fpscr.VE == 0 && ppc_state.fpscr.ZE == 0 &&
+        TryFastAlignedRamOffset(ppc_state, ram, ram_size, inner_sp, 56, &inner_stack_offset) &&
+        !overlaps(offset, 48, inner_stack_offset, 56) &&
+        !overlaps(inner_stack_offset, 56, zero_offset, 4) &&
+        !overlaps(inner_stack_offset, 56, f31_offset, 8))
+    {
+      const u32 p0_bits = ReadRamU32BE(ram, offset + 32);
+      const u32 p1_bits = ReadRamU32BE(ram, offset + 36);
+      const u32 d0_bits = ReadRamU32BE(ram, offset + 40);
+      const double p0 = std::bit_cast<double>(ConvertToDouble(p0_bits));
+      const double p1 = std::bit_cast<double>(ConvertToDouble(p1_bits));
+      const double d0 = std::bit_cast<double>(ConvertToDouble(d0_bits));
+      if (!std::isfinite(next_time) || !std::isfinite(p0) || !std::isfinite(p1) ||
+          !std::isfinite(d0))
+      {
+        ppc_state.pc = target;
+        ppc_state.npc = target;
+        ppc_state.downcount -= static_cast<int>(cycles);
+        UpdatePerformanceMonitorIfNeeded(cycles, loadstores, fp, ppc_state);
+        return 0;
+      }
+
+      // A normal cached-interpreter block checks downcount before dispatching
+      // the next basic block.  The interpolation shortcut spans several such
+      // blocks, so only cross them when the complete path fits in the current
+      // timing slice.  Otherwise stop at the already-validated 0x8036b5f0
+      // continuation and let the original blocks preserve event ordering.
+      const std::array<u32, 3> planned_interpolation_metric =
+          op == 1 ? (next_time >= static_cast<float>(fterm) ? constant_at_least : constant_less) :
+                    ((flags & 0x20) == 0 ? linear_cached :
+                     (fterm != 0 ? linear_init_nonzero : linear_init_zero));
+      const u64 fused_cycle_count =
+          static_cast<u64>(cycles) + planned_interpolation_metric[0];
+      if (ppc_state.downcount <= 0 ||
+          static_cast<u64>(ppc_state.downcount) <= fused_cycle_count)
+      {
+        ppc_state.pc = target;
+        ppc_state.npc = target;
+        ppc_state.downcount -= static_cast<int>(cycles);
+        UpdatePerformanceMonitorIfNeeded(cycles, loadstores, fp, ppc_state);
+        return 0;
+      }
+
+      // Outer comparison temporaries written before the call.
+      WriteRamU32BE(ram, stack_offset + 112, 0x43300000);
+      WriteRamU32BE(ram, stack_offset + 116, fterm);
+
+      // FObjUpdateAnim's 56-byte frame. inner+60 aliases outer+4.
+      WriteRamU32BE(ram, inner_stack_offset, new_sp);
+      WriteRamU32BE(ram, inner_stack_offset + 44, 0x43300000);
+      WriteRamU32BE(ram, inner_stack_offset + 48, 0x80406350);
+      WriteRamU32BE(ram, inner_stack_offset + 52, fobj);
+      WriteRamU32BE(ram, stack_offset + 4, 0x8036b66c);
+
+      ppc_state.gpr[0] = op;
+      ppc_state.gpr[1] = inner_sp;
+      ppc_state.gpr[3] = fobj;
+      ppc_state.gpr[4] = obj;
+      ppc_state.gpr[5] = obj_update;
+      ppc_state.gpr[29] = fobj;
+      ppc_state.gpr[30] = obj;
+      ppc_state.gpr[31] = obj_update;
+      LR(ppc_state) = 0x8036b66c;
+      FastUpdateCR0(ppc_state, 0);
+      const double magic = ppc_state.ps[31].PS0AsDouble();
+      const double encoded_term =
+          std::bit_cast<double>((static_cast<u64>(0x43300000) << 32) | fterm);
+      std::array<u32, 3> interpolation_metric = planned_interpolation_metric;
+      if (op == 1)
+      {
+        WriteRamU32BE(ram, inner_stack_offset + 36, fterm);
+        WriteRamU32BE(ram, inner_stack_offset + 32, 0x43300000);
+        ppc_state.gpr[3] = fterm;
+        ppc_state.gpr[0] = 0x43300000;
+        ppc_state.ps[1].SetPS0(magic);
+        ppc_state.ps[2].Fill(next_time);
+        const float term =
+            ForceSingle(ppc_state.fpscr, NI_sub(ppc_state, encoded_term, magic).value);
+        ppc_state.ps[0].Fill(term);
+        ppc_state.UpdateFPRFSingle(term);
+        u32 compare = static_cast<u32>(FPCC::FE);
+        if (next_time < term)
+          compare = static_cast<u32>(FPCC::FL);
+        else if (next_time > term)
+          compare = static_cast<u32>(FPCC::FG);
+        ppc_state.fpscr.FPRF = (ppc_state.fpscr.FPRF & ~FPCC_MASK) | compare;
+        ppc_state.cr.SetField(0, compare | ((compare & (PowerPC::CR_GT | PowerPC::CR_EQ)) ?
+                                               PowerPC::CR_EQ : 0));
+        const bool at_least = next_time >= term;
+        const u32 value_bits = at_least ? p1_bits : p0_bits;
+        ppc_state.ps[0].Fill(ConvertToDouble(value_bits));
+        WriteRamU32BE(ram, inner_stack_offset + 20, value_bits);
+        interpolation_metric = at_least ? constant_at_least : constant_less;
+      }
+      else
+      {
+        ppc_state.gpr[3] = flags;
+        ppc_state.gpr[0] = flags & 0x20;
+        FastUpdateCR0(ppc_state, ppc_state.gpr[0]);
+        if ((flags & 0x20) != 0)
+        {
+          ram[offset + 16] = static_cast<u8>(flags & ~0x20);
+          ppc_state.gpr[0] = fterm;
+          SetFastCompareField<u32>(ppc_state, 0, fterm, 0);
+          if (fterm != 0)
+          {
+            WriteRamU32BE(ram, inner_stack_offset + 36, fterm);
+            WriteRamU32BE(ram, inner_stack_offset + 32, 0x43300000);
+            ppc_state.gpr[0] = 0x43300000;
+            ppc_state.ps[3].Fill(p1);
+            ppc_state.ps[2].Fill(p0);
+            ppc_state.ps[1].SetPS0(magic);
+            ppc_state.ps[0].SetPS0(encoded_term);
+            const float delta =
+                ForceSingle(ppc_state.fpscr, NI_sub(ppc_state, p1, p0).value);
+            ppc_state.ps[2].Fill(delta);
+            ppc_state.UpdateFPRFSingle(delta);
+            const float term =
+                ForceSingle(ppc_state.fpscr, NI_sub(ppc_state, encoded_term, magic).value);
+            ppc_state.ps[0].Fill(term);
+            ppc_state.UpdateFPRFSingle(term);
+            const float slope =
+                ForceSingle(ppc_state.fpscr, NI_div(ppc_state, delta, term).value);
+            ppc_state.ps[0].Fill(slope);
+            ppc_state.UpdateFPRFSingle(slope);
+            WriteRamU32BE(ram, offset + 40, ConvertToSingle(ppc_state.ps[0].PS0AsU64()));
+            interpolation_metric = linear_init_nonzero;
+          }
+          else
+          {
+            const u32 zero_bits = ReadRamU32BE(ram, zero_offset);
+            ppc_state.ps[0].Fill(ConvertToDouble(zero_bits));
+            WriteRamU32BE(ram, offset + 40, zero_bits);
+            ppc_state.ps[0].Fill(p1);
+            WriteRamU32BE(ram, offset + 32, p1_bits);
+            interpolation_metric = linear_init_zero;
+          }
+        }
+        else
+        {
+          interpolation_metric = linear_cached;
+        }
+        const u32 updated_d0_bits = ReadRamU32BE(ram, offset + 40);
+        const u32 updated_p0_bits = ReadRamU32BE(ram, offset + 32);
+        const double updated_d0 =
+            std::bit_cast<double>(ConvertToDouble(updated_d0_bits));
+        const double updated_p0 =
+            std::bit_cast<double>(ConvertToDouble(updated_p0_bits));
+        ppc_state.ps[2].Fill(updated_d0);
+        ppc_state.ps[1].Fill(next_time);
+        ppc_state.ps[0].Fill(updated_p0);
+        // Mirror EmitSinglePrecisionArithmetic exactly: f64 multiply/add,
+        // then a WASM f32 demote/promote into both lanes.  That emitted path
+        // deliberately leaves FPSCR unchanged.
+        const float value = static_cast<float>(updated_d0 * next_time + updated_p0);
+        ppc_state.ps[0].Fill(value);
+        WriteRamU32BE(ram, inner_stack_offset + 20,
+                      ConvertToSingle(ppc_state.ps[0].PS0AsU64()));
+      }
+
+      cycles += interpolation_metric[0];
+      loadstores += interpolation_metric[1];
+      fp += interpolation_metric[2];
+      count(s_melee_anim_probe_linear_direct);
+
+      // The old continuation returned to guest code for six callback-setup
+      // instructions, dispatched the already-specialized JObjUpdateFunc, and
+      // then ran two small epilogues.  Those dispatches are a large fraction
+      // of this overwhelmingly common animation path.  Admit the same cases

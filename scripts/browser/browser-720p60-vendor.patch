+#ifdef __EMSCRIPTEN__
+  // Browser GPU worker: return to JS between bounded batches, allowing the
+  // canvas implementation to retire transferred images. Native Run is intact.
+  void RunAsync(std::function<void()> payload, std::function<void()> stopped)
+  {
+    Prepare();
+    struct Pending { BlockingLoop* loop; std::function<void()> run, stop; };
+    auto* pending = new Pending{this, std::move(payload), std::move(stopped)};
+    EM_ASM({ Module._meleeGpuWaitAddress = $0 >>> 0; }, &m_running_state);
+    emscripten_set_timeout_loop([](double, void* opaque) -> bool {
+      auto* p = static_cast<Pending*>(opaque);
+      auto& loop = *p->loop;
+      // Retain the final execution after a concurrent Wakeup, just as Run does.
+      for (unsigned n = 0; n < 8 && !loop.m_shutdown.IsSet(); ++n)
+      {
+        p->run();
+        const auto state = loop.m_running_state.load();
+        if (state == STATE_NEED_EXECUTION) { loop.m_running_state--; continue; }
+        if (state == STATE_LAST_EXECUTION)
+        {
+          if (loop.m_running_state-- != STATE_LAST_EXECUTION) continue;
+          loop.m_done_event.Set();
+        }
+        break;
+      }
+      if (!loop.m_shutdown.IsSet()) return true;
+      loop.m_running_state.store(STATE_DONE);
+      loop.m_stopped.Set();
+      loop.m_done_event.Set();
+      EM_ASM({ Module._meleeGpuWaitAddress = 0; });
+      auto stopped = std::move(p->stop);
+      delete p;
+      stopped();
+      return false;
+    }, 0, pending);
+  }

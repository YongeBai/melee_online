+      0x8037036c, 0x80370370, 0x80370374, 0x8037037c, 0x80370380, 0x80370384,
+      0x80370398, 0x8037039c, 0x803703a0, 0x803703a4});
+  const auto scale_dirty = make_path({
+      0x80370354, 0x80370358, 0x8037035c, 0x80370360, 0x80370364, 0x80370368,
+      0x8037036c, 0x80370370, 0x80370374, 0x8037037c, 0x80370380, 0x80370384,
+      0x80370398, 0x8037039c, 0x803703a0, 0x803703a4, 0x803703a8, 0x803703ac,

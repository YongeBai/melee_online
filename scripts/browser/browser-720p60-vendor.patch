+  constexpr std::array<u32, 34> flush_expected = {
+      0x806da508, 0x38000098, 0x3ca0cc01, 0xa0c30004, 0x38800000, 0xa0630006,
+      0x7ce619d6, 0x98058000, 0xb0c58000, 0x38670003, 0x28070000, 0x5463f0be,
+      0x40810048, 0x5460e8ff, 0x7c0903a6, 0x41820030, 0x90858000, 0x90858000,

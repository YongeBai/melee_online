+      return false;
+    const GekkoOPInfo& opinfo = *PPCTables::GetOpInfo(UGeckoInstruction{result.hex}, address);
+    // The clean path bypasses both conditional calls. The dirty prefix runs
+    // through the first call, and the accelerated suffix bypasses the flush.
+    if (i == 11 || i == 16)
+    {
+      if (i == 11)
+        add_metric(dirty_prefix, opinfo);
+    }
+    else
+    {
+      add_metric(clean, opinfo);
+      if (i <= 10)
+        add_metric(dirty_prefix, opinfo);
+      if (i >= 12)
+        add_metric(ready_suffix, opinfo);
+      if (i >= 12 && i <= 15)
+        add_metric(flush_prefix, opinfo);
+      if (i >= 17)
+        add_metric(tail_metric, opinfo);
+    }

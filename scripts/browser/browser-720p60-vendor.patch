+  ppc_state.ps[0].SetBoth(f0[0], f0[1]);
+  ppc_state.ps[1].SetBoth(f1[0], f1[1]);
+  ppc_state.ps[2].SetBoth(f2[0], f2[1]);
+  ppc_state.ps[3].SetBoth(f3[0], f3[1]);
+  ppc_state.ps[4].SetBoth(f4[0], f4[1]);
+  ppc_state.ps[5].SetBoth(f5[0], f5[1]);
+  ppc_state.ps[6].SetBoth(f6[0], f6[1]);
+  ppc_state.ps[7].SetBoth(f7[0], f7[1]);
+  ppc_state.ps[8].SetBoth(f8[0], f8[1]);
+  ppc_state.ps[9].SetBoth(f9[0], f9[1]);
+  ppc_state.ps[10].SetBoth(f10[0], f10[1]);
+  ppc_state.ps[11].SetBoth(f11[0], f11[1]);
+  ppc_state.ps[12].SetBoth(f12[0], f12[1]);
+  ppc_state.ps[13].SetBoth(f13[0], f13[1]);

+  if (boundary.check_target && !boundary.soft_exit)
+  {
+    // A took the other branch: dispatch its real NPC with only A debited.
+    EmitStateLoadU32(body, boundary.npc_offset); EmitI32Const(body, boundary.target_pc);
+    body.insert(body.end(), {0x47,0x72});
+  }

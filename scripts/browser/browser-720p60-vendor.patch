+bool CanCacheQState(std::span<const PPCAnalyst::CodeOp> ops)
+{
+  if (!CanCacheBlockMsr(ops)) return false;
+  u32 accesses=0;
+  for (const auto& op : ops)
+    if (!op.skip && op.inst.I==0 &&
+        (op.inst.OPCD==56 || op.inst.OPCD==57 || op.inst.OPCD==60 || op.inst.OPCD==61))
+      ++accesses;
+  return accesses>=4;
+}
+
+// Avoid adding a guard to memory-only blocks or a single arithmetic check.
+bool CanHoistFpuGuard(std::span<const PPCAnalyst::CodeOp> ops,
+                      std::optional<u32> fused_call_index = std::nullopt)
+{
+  if (!CanCacheBlockMsr(ops, fused_call_index)) return false;
+  u32 arithmetic=0;
+  for (const auto& op : ops)
+    if (!op.skip && (op.inst.OPCD==4 || op.inst.OPCD==59)) ++arithmetic;
+  return arithmetic>=2;
+}
+
+// Two original blocks may share register locals, but keep the original
+// architectural timing boundary. A register-only prefix cannot invalidate B.
+struct WasmFusionBoundary
+{
+  u32 after_ops = 0, target_pc = 0;
+  u32 pc_offset = 0, downcount_offset = 0;
+  u32 cpu_state = 0, running_state = 0;
+  u32 step_armed = 0, step_start = 0, step_counter = 0;
+  u32 npc_offset = 0;
+  bool check_target = false;
+  bool track_reads = false;
+  bool soft_exit = false;
+  const WasmFusionBoundary* next = nullptr;
+};
+
+bool IsFusionSafeInstruction(const PPCAnalyst::CodeOp& op, bool register_only)
+{
+  if (op.skip) return true;
+  const auto i = op.inst;
+  if (i.OPCD >= 32 && i.OPCD <= 57) return !register_only;
+  if (i.OPCD == 60 || i.OPCD == 61) return !register_only;
+  switch (i.OPCD)
+  {
+  case 7: case 8: case 10: case 11: case 12: case 13: case 14: case 15:
+  case 20: case 21: case 23: case 24: case 25: case 26: case 27: case 28: case 29:
+    return true;
+  case 16: case 18:
+    return !i.LK;
+  case 19:
+    return !i.LK && (i.SUBOP10 == 16 || i.SUBOP10 == 528);
+  case 4:
+    return !i.Rc && (IsPairedSingleArithmeticSubop(i.SUBOP5) ||
+                    IsPairedSingleMergeSubop(i.SUBOP10));
+  case 59:
+    return !i.Rc && IsSinglePrecisionArithmeticSubop(i.SUBOP5);
+  case 63:
+    return !i.Rc && (IsDoublePrecisionArithmeticSubop(i.SUBOP5) ||
+        i.SUBOP10 == 0 || i.SUBOP10 == 32 || i.SUBOP10 == 12 ||
+        i.SUBOP10 == 15 || i.SUBOP10 == 26 || i.SUBOP10 == 40 ||
+        i.SUBOP10 == 136 || i.SUBOP10 == 264 || i.SUBOP10 == 72);
+  case 31:
+    switch (i.SUBOP10)
+    {
+    case 0: case 11: case 19: case 24: case 26: case 28: case 32:
+    case 60: case 75: case 124: case 144: case 316: case 444: case 476:
+    case 536: case 792: case 824: case 922: case 954:
+      return true;
+    case 8: case 10: case 40: case 104: case 136: case 138: case 202:
+    case 235: case 266:
+      return !i.OE;
+    case 23: case 55: case 87: case 119: case 151: case 183: case 215:
+    case 247: case 279: case 311: case 343: case 375: case 407: case 439:
+      return !register_only;
+    default:
+      return false; // No SPR/MSR/cache, time-base or broad system helpers.
+    }
+  default:
+    return false;
+  }
+}
+
+bool IsReadFusionLoad(const PPCAnalyst::CodeOp& op)
+{
+  return !op.skip && (op.inst.OPCD==32 || op.inst.OPCD==34 ||
+                      op.inst.OPCD==40 || op.inst.OPCD==42);
+}
+
+// Indexed integer memory and ordinary integer arithmetic do not change MSR.
+// Keep the original proof policy for every other opcode, including all FPU
+// arithmetic. This widens only admission, not emitted arithmetic or faults.
+bool CanHoistFpuGuardWide(std::span<const PPCAnalyst::CodeOp> ops)
+{
+  std::vector<PPCAnalyst::CodeOp> remainder;
+  remainder.reserve(ops.size());
+  for (const auto& op : ops)
+  {
+    if (!op.skip && op.inst.OPCD == 31)
+    {
+      const auto i=op.inst;
+      const u32 spr=i.SUBOP10==339?DecodeMfsprIndex(i):i.SUBOP10==467?DecodeMtsprIndex(i):0xffffffffu;
+      const bool ordinary_spr=spr==SPR_LR || spr==SPR_CTR || spr==SPR_XER;
+      if (!ordinary_spr && !IsFusionSafeInstruction(op, false)) return false;
+    }
+    else remainder.push_back(op);
+  }
+  return CanHoistFpuGuard(remainder);
+}
+
+void EmitFusionBoundary(std::vector<u8>& body, const WasmFusionBoundary& boundary,
+                        u32 cycles)
+{
+  // B and its helpers must see the same live budget/PC as separate dispatch.
+  EmitStateLoadU32(body, boundary.downcount_offset);

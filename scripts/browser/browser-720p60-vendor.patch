+      SetFastFI(ppc_state, 1);
+      ppc_state.fpscr.FR = std::fabs(converted) > std::fabs(value);
+    }
+  }
+  else
+  {
+    result = std::signbit(value) ? 0x80000000u : 0x7fffffffu;

+std::size_t BrowserSave(Core::System& system, unsigned slot, bool gpu_resident)
+{
+  if (slot >= browser_states.size() || (gpu_resident && !g_texture_cache)) return 0;
+  browser_state_sizes[slot] = 0;
+  browser_states_gpu[slot] = gpu_resident;
+  const BrowserTextureStateScope texture_scope(slot, gpu_resident, true);
+  const DolphinWeb::BrowserStateTransferScope transfer_scope;
+  constexpr std::size_t max_bytes = 128 * 1024 * 1024;
+  constexpr std::size_t total_budget = 640 * 1024 * 1024;
+  // Measure before allocating; never let an unexpected game/state consume
+  // the remaining shared WASM heap. SaveToBuffer reuses the allocation.
+  const auto measure_started = BrowserClockUs();
+  u8* ptr = nullptr;
+  PointerWrap measure(&ptr, 0, PointerWrap::Mode::Measure);
+  DoState(system, measure);
+  const auto size = measure.GetOffsetFromPreviousPosition(nullptr);
+  browser_measure_us[slot] = BrowserClockUs() - measure_started;
+  browser_required_size = size;
+  const auto allocation_started = BrowserClockUs();
+  if (!size || size > max_bytes) return 0;
+  auto& buffer = browser_states[slot];
+  if (buffer.size() < size)
+  {
+    std::size_t allocated = 0;
+    for (const auto& existing : browser_states) allocated += existing.size();
+    if (allocated - buffer.size() + size > total_budget) return 0;
+    // The slot is already invalid. Free its old allocation before allocating
+    // the replacement, avoiding a second full snapshot at peak heap usage.
+    buffer.reset();
+    buffer.reset(size);
+  }
+  browser_allocate_us[slot] = BrowserClockUs() - allocation_started;
+  browser_state_sections[slot].clear();
+  browser_section_base = buffer.data();
+  browser_sections_recording = &browser_state_sections[slot];
+  browser_write_started = BrowserClockUs();
+  browser_state_sizes[slot] = SaveToBuffer(system, buffer);
+  browser_sections_recording = nullptr;
+  if (gpu_resident && g_texture_cache->BrowserStateFailed()) browser_state_sizes[slot] = 0;
+  return browser_state_sizes[slot];
+}
+inline bool CoherentInstructionCache(Core::System& system) {
+  const auto& cache=system.GetPPCState().iCache;
+  auto& memory=system.GetMemory();
+  for (u32 set=0;set<PowerPC::CACHE_SETS;++set)
+    for (u32 way=0;way<PowerPC::CACHE_WAYS;++way) {
+      if (!(cache.valid[set] & (1u<<way))) continue;
+      const u32 address=cache.addrs[set][way];
+      if (address>memory.GetRamSize()-32 ||
+          std::memcmp(cache.data[set][way].data(),memory.GetRAM()+address,32)!=0) return false;
+    }
+  return true;
+}
+class CodeRestoreGuard {
+  Core::System& system;
+  struct Range {u32 from; std::vector<u8> bytes;};
+  std::vector<Range> saved;
+public:
+  explicit CodeRestoreGuard(Core::System& s):system(s) {
+    browser_last_kept_jit = false;
+    browser_keep_jit = CoherentInstructionCache(s);
+    if (!browser_keep_jit) return;
+    Core::CPUThreadGuard guard(s);
+    Common::RangeSet<u32> ranges;
+    s.GetJitInterface().RunOnBlocks(guard,[&](const JitBlock& block){
+      for (auto [from,to]:block.physical_addresses) ranges.insert(from,to);
+    });
+    auto& memory=s.GetMemory();
+    for (auto [from,to]:ranges) {
+      if (to>memory.GetRamSize()) {browser_keep_jit=false;break;}
+      saved.push_back({from,{memory.GetRAM()+from,memory.GetRAM()+to}});
+    }
+  }
+  ~CodeRestoreGuard() {
+    if (browser_keep_jit) {
+      bool valid=CoherentInstructionCache(system);
+      const auto* ram=system.GetMemory().GetRAM();
+      for (const auto& range:saved)
+        if (std::memcmp(range.bytes.data(),ram+range.from,range.bytes.size())!=0) {valid=false;break;}
+      browser_last_kept_jit = valid;
+      if (!valid) {
+        Core::CPUThreadGuard guard(system);
+        system.GetJitInterface().ClearCache(guard);
+      }
+    }
+    browser_keep_jit=false;
+  }
+};
+bool BrowserLoad(Core::System& system, unsigned slot)
+{
+  if (slot >= browser_states.size() || !browser_state_sizes[slot]) return false;
+  // Source bytes and instruction-cache coherence must agree on both sides
+  // of restore before compiled blocks may be retained.
+  const BrowserLoadingScope loading_scope;
+  const DolphinWeb::BrowserStateTransferScope transfer_scope;
+  CodeRestoreGuard code_guard(system);
+  if (browser_states_gpu[slot] && !g_texture_cache) return false;
+  const BrowserTextureStateScope texture_scope(slot, browser_states_gpu[slot], false);
+  return LoadFromBuffer(system, std::span<u8>(browser_states[slot].data(), browser_state_sizes[slot]));
+}
+bool BrowserEqual(unsigned a, unsigned b)
+{
+  return a < browser_states.size() && b < browser_states.size() && !browser_states_gpu[a] && !browser_states_gpu[b] && browser_state_sizes[a] &&
+         browser_state_sizes[a] == browser_state_sizes[b] &&
+         std::memcmp(browser_states[a].data(), browser_states[b].data(), browser_state_sizes[a]) == 0;
+}
+std::string BrowserCompare(unsigned a, unsigned b)
+{
+  if (a >= browser_states.size() || b >= browser_states.size() || !browser_state_sizes[a] || !browser_state_sizes[b])
+    return R"({"error":"Invalid checkpoints"})";
+  if (browser_states_gpu[a] || browser_states_gpu[b])
+    return R"({"error":"GPU checkpoints must be verified using full captures"})";
+  const auto* x = browser_states[a].data();
+  const auto* y = browser_states[b].data();
+  std::string report = fmt::format(R"({{"sizeA":{},"sizeB":{},"retainedCode":{},"sections":[)", browser_state_sizes[a], browser_state_sizes[b], browser_last_kept_jit);
+  std::size_t start_a = 0, start_b = 0;
+  const auto& sections_a = browser_state_sections[a];
+  const auto& sections_b = browser_state_sections[b];
+  if (sections_a.size() != sections_b.size()) return R"({"error":"Section count differs"})";
+  for (std::size_t n = 0; n < sections_a.size(); ++n)
+  {
+    const auto& sa = sections_a[n];
+    const auto& sb = sections_b[n];
+    if (std::strcmp(sa.name, sb.name)) return R"({"error":"Section order differs"})";
+    const auto size_a = sa.end - start_a, size_b = sb.end - start_b;
+    const auto common = std::min(size_a, size_b);
+    std::size_t different = 0, first = common;
+    for (std::size_t i = 0; i < common; ++i)
+      if (x[start_a+i] != y[start_b+i]) { ++different; if (first == common) first = i; }
+    if (n) report += ",";
+    report += fmt::format(R"({{"name":"{}","startA":{},"startB":{},"bytesA":{},"bytesB":{},"differentBytes":{},"firstRelativeOffset":{}}})",
+      sa.name, start_a, start_b, size_a, size_b, different,
+      first == common ? -1 : static_cast<int>(first));
+    start_a = sa.end;
+    start_b = sb.end;
+  }
+  return report + "]}";
+}
+std::string BrowserCaptureProfile(unsigned slot)
+{
+  if (slot >= browser_states.size()) return "{}";
+  std::string result = fmt::format(R"({{"measureUs":{},"allocateUs":{},"gpuTextureBytes":{},"writeSections":[)",
+      browser_measure_us[slot], browser_allocate_us[slot], g_texture_cache ? g_texture_cache->BrowserTextureBytes() : 0);
+  u64 previous = 0;
+  bool comma = false;
+  for (const auto& section : browser_state_sections[slot])
+  {
+    if (comma) result += ",";
+    result += fmt::format(R"({{"name":"{}","writeUs":{}}})", section.name, section.write_us - previous);
+    previous = section.write_us;
+    comma = true;
+  }
+  return result + "]}";
+}
+bool BrowserRelease(Core::System& system, unsigned slot)
+{
+  if (slot >= browser_states.size()) return false;
+  browser_state_sizes[slot] = 0;
+  browser_states_gpu[slot] = false;
+  browser_states[slot].reset();
+  browser_state_sections[slot].clear();
+  if (g_texture_cache)
+  {
+    auto release = [slot] { g_texture_cache->BrowserReleaseState(slot); };
+    if (system.IsDualCoreMode()) AsyncRequests::GetInstance()->PushBlockingEvent(release);
+    else release();
+  }
+  return true;
+}
+void BrowserClear()
+{
+  auto& system = Core::System::GetInstance();
+  if (g_texture_cache && Core::IsRunning(system))
+  {
+    const Core::CPUThreadGuard guard(system);
+    auto clear = [] { if (g_texture_cache) g_texture_cache->BrowserClearStates(); };
+    if (system.IsDualCoreMode()) AsyncRequests::GetInstance()->PushBlockingEvent(clear);
+    else clear();
+  }
+  browser_states_gpu.fill(false);
+  for (auto& state : browser_states) state.reset();
+  browser_state_sizes.fill(0);
+}

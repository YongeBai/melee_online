diff --git a/Source/Core/Common/BrowserStateCopy.h b/Source/Core/Common/BrowserStateCopy.h
new file mode 100644
index 0000000000..fb783ba1cc
--- /dev/null
+++ b/Source/Core/Common/BrowserStateCopy.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <atomic>
+#include "Common/BrowserCopyBytes.h"
+#include "Common/ChunkFile.h"
+namespace DolphinWeb {
+inline std::atomic<bool> browser_state_transfer_active{false};
+struct BrowserStateTransferScope {
+  BrowserStateTransferScope() { browser_state_transfer_active.store(true, std::memory_order_release); }
+  ~BrowserStateTransferScope() { browser_state_transfer_active.store(false, std::memory_order_release); }
+};
+inline void TransferSnapshotMemory(PointerWrap& p, u8* data, u32 bytes)
+{
+  if (!browser_state_transfer_active.load(std::memory_order_acquire))
+  {
+    p.DoArray(data, bytes);
+    return;
+  }
+  // This length-prefixed form is private to browser in-memory checkpoints.
+  // Disk savestates keep Dolphin's original serialization format.
+  u32 stored_size = bytes;
+  u8* storage = p.DoExternal(stored_size);
+  if (p.IsReadMode())
+  {
+    if (stored_size != bytes) { p.SetVerifyMode(); return; }
+    CopySnapshotBytes(data, storage, bytes);
+  }
+  else if (p.IsWriteMode()) CopySnapshotBytes(storage, data, bytes);
+}
+}

+  explicit BrowserTextureStateScope(unsigned slot, bool active, bool saving) : enabled(active)
+  { if (enabled) g_texture_cache->BrowserBeginState(slot, saving); }
+  ~BrowserTextureStateScope() { if (enabled) g_texture_cache->BrowserEndState(); }
+  bool enabled;
+};
+static std::array<std::vector<BrowserStateSection>, 6> browser_state_sections;

+// Bounded, uncompressed complete-machine checkpoints, private to this core.
+// Six slots support a 12-frame window with checkpoints every four frames.
+static std::array<Common::UniqueBuffer<u8>, 6> browser_states;
+static std::array<std::size_t, 6> browser_state_sizes{};
+static std::array<bool, 6> browser_states_gpu{};
+struct BrowserTextureStateScope

+// Explicit paused-machine API. RunFrame() remains a presentation poll and
+// must never be mistaken for an emulation step by the network scheduler.
+EMSCRIPTEN_KEEPALIVE int BrowserRollbackCapture(int slot)
+{
+  auto& system = Core::System::GetInstance();
+  if (!s_runtime_initialized || slot < 0 || Core::GetState(system) != Core::State::Paused) return 0;
+  const Core::CPUThreadGuard guard(system);
+  return static_cast<int>(State::BrowserSave(system, static_cast<unsigned>(slot)));
+}
+EMSCRIPTEN_KEEPALIVE int BrowserRollbackRestore(int slot)
+{
+  auto& system = Core::System::GetInstance();
+  if (!s_runtime_initialized || slot < 0 || Core::GetState(system) != Core::State::Paused) return 0;
+  const Core::CPUThreadGuard guard(system);
+  return State::BrowserLoad(system, static_cast<unsigned>(slot)) ? 1 : 0;
+}
+EMSCRIPTEN_KEEPALIVE int BrowserRollbackEqual(int a, int b)
+{
+  return a >= 0 && b >= 0 && State::BrowserEqual(static_cast<unsigned>(a), static_cast<unsigned>(b));
+}
+EMSCRIPTEN_KEEPALIVE int BrowserRollbackStep()
+{
+  auto& system = Core::System::GetInstance();
+  if (!s_runtime_initialized || Core::GetState(system) != Core::State::Paused) return 0;
+  Core::DoFrameStep(system);
+  return 1;
+}
+EMSCRIPTEN_KEEPALIVE void BrowserRollbackClear()
+{
+  State::BrowserClear();
+}

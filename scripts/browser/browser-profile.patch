+      << ",\"syncOnSkipIdle\":" << Config::Get(Config::MAIN_SYNC_ON_SKIP_IDLE)
+      << ",\"rushPresentation\":" << Config::Get(Config::MAIN_RUSH_FRAME_PRESENTATION)
+      << ",\"smoothPresentation\":" << Config::Get(Config::MAIN_SMOOTH_EARLY_PRESENTATION)
+      << ",\"correctTimeDrift\":" << Config::Get(Config::MAIN_CORRECT_TIME_DRIFT)
+      << ",\"stages\":{";
+  for (std::size_t i = 0; i < DolphinWeb::BrowserProfile::counters.size(); ++i)

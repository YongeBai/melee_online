+    out << '\"' << DolphinWeb::BrowserProfile::names[i] << "\":{\"count\":" << c.count.load()
+        << ",\"totalUs\":" << c.total_us.load() << ",\"maxUs\":" << c.max_us.load() << '}';
+  }
+  out << "}}";
+  result = out.str();
+  return result.c_str();

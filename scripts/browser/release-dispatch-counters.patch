+// The dispatch counter is useful while comparing execution strategies, but it
+// sits on the hottest edge in the browser core: once for every generated PPC
+// block. Release builds compile the counter object and its atomic increment
+// away while preserving the normal (Diagnostics=true) dispatcher layout.
+#ifndef DOLPHIN_WEB_DISPATCH_COUNTERS
+#define DOLPHIN_WEB_DISPATCH_COUNTERS 1
+#endif

+// Host-only throttle policy. This leaves the virtual clock and code cache intact.
+EMSCRIPTEN_KEEPALIVE const char* BrowserRushPresentation(int mode)
+{
+  auto& system = Core::System::GetInstance();
+  if (!s_runtime_initialized || mode < -1 || mode > 1 || Core::GetState(system) != Core::State::Paused)
+    return "{\"error\":\"Rush presentation control requires a paused machine and -1/0/1\"}";
+  const Core::CPUThreadGuard guard(system);
+  auto& timing = system.GetCoreTiming();
+  if (mode != -1)
+  {
+    Config::SetBase(Config::MAIN_RUSH_FRAME_PRESENTATION, mode != 0);
+    timing.SetBrowserRushPresentation(mode != 0);
+  }
+  static std::string result;
+  result = "{\"enabled\":" + std::string(timing.GetBrowserRushPresentation() ? "true" : "false") +
+      ",\"calls\":" + std::to_string(timing.GetBrowserThrottleCalls()) +
+      ",\"skips\":" + std::to_string(timing.GetBrowserThrottleSkips()) + "}";
+  return result.c_str();
+}

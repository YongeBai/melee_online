+// Cache only arithmetic blocks with enough reuse to amortize eager loads and
+// exit flushes. This is a measured experiment; the runtime flag stays opt-in.
+bool ShouldCacheMathFpr(std::span<const PPCAnalyst::CodeOp> ops)
+{
+  u32 floating = 0, references = 0;
+  BitSet32 used;
+  for (const auto& op : ops)
+  {
+    if (op.skip) continue;
+    const auto i = op.inst;
+    bool fp = false;
+    if (i.OPCD >= 32 && i.OPCD <= 45) {} // ordinary integer memory
+    else if ((i.OPCD >= 48 && i.OPCD <= 57) || i.OPCD == 60 || i.OPCD == 61)
+      fp = true;
+    else switch (i.OPCD)
+    {
+    case 7: case 8: case 10: case 11: case 12: case 13: case 14: case 15:
+    case 20: case 21: case 23: case 24: case 25: case 26: case 27: case 28: case 29:
+      break;
+    case 16: case 18:
+      if (i.LK) return false; // SDK/HLE substitutions may touch many FPRs.
+      break;
+    case 19:
+      if (i.LK || (i.SUBOP10 != 16 && i.SUBOP10 != 528)) return false;
+      break;
+    case 4:
+      if (i.Rc || (!IsPairedSingleArithmeticSubop(i.SUBOP5) &&
+                   !IsPairedSingleMergeSubop(i.SUBOP10))) return false;
+      fp = true;
+      break;
+    case 59:
+      if (i.Rc || !IsSinglePrecisionArithmeticSubop(i.SUBOP5)) return false;
+      fp = true;
+      break;
+    default:
+      return false; // Includes canonical frsqrte and system helper calls.
+    }
+    if (fp) ++floating;
+    used |= op.fregsIn;
+    references += op.fregsIn.Count();
+    if (op.fregOut >= 0 && op.fregOut < 32)
+    {
+      used[op.fregOut] = true;
+      ++references;
+    }
+  }
+  return floating >= 12 && references >= 3 * used.Count();
+}

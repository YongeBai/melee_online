+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace BrowserStateDiff
+{
+struct Range { std::size_t offset, length; };
+struct Summary
+{
+  std::size_t different_bytes = 0, unmatched_bytes = 0, range_count = 0;
+  std::vector<Range> ranges;
+};
+// Diagnostic only. Raw checkpoint equality remains a full memcmp.
+inline Summary Compare(std::span<const std::uint8_t> a, std::span<const std::uint8_t> b,
+                       std::size_t limit = 32)
+{
+  Summary result;
+  const auto common = std::min(a.size(), b.size());
+  const auto total = std::max(a.size(), b.size());
+  result.unmatched_bytes = total - common;
+  bool in_range = false;
+  for (std::size_t i = 0; i < total; ++i)
+  {
+    const bool different = i >= common || a[i] != b[i];
+    if (different && i < common) ++result.different_bytes;
+    if (different)
+    {
+      if (!in_range)
+      {
+        ++result.range_count;
+        if (result.ranges.size() < limit) result.ranges.push_back({i, 0});
+      }
+      if (result.range_count <= limit) ++result.ranges.back().length;
+    }
+    in_range = different;
+  }
+  return result;
+}
+}

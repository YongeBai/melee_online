+// Private scheduling experiment: only the initial deterministic GPU service
+// event moves. Existing FIFO reads, CP status, MMIO synchronization, command
+// ordering and all non-deterministic/single-core paths remain unchanged.
+static std::atomic<int> s_browser_gpu_start_delay{1000};
+static std::atomic<u64> s_browser_gpu_starts{0}, s_browser_gpu_callbacks{0};
+extern "C" const char* DolphinWeb_GpuStartDelay(int cycles)
+{
+  if (cycles != -1 && cycles != 1000 && cycles != 2000 && cycles != 4000 && cycles != 8000)
+    return "{\"error\":\"GPU start delay must be -1,1000,2000,4000 or 8000\"}";
+  if (cycles != -1) s_browser_gpu_start_delay.store(cycles, std::memory_order_relaxed);
+  static std::string result;
+  result = "{\"cycles\":" + std::to_string(s_browser_gpu_start_delay.load(std::memory_order_relaxed)) +
+      ",\"starts\":" + std::to_string(s_browser_gpu_starts.load(std::memory_order_relaxed)) +
+      ",\"callbacks\":" + std::to_string(s_browser_gpu_callbacks.load(std::memory_order_relaxed)) + "}";
+  return result.c_str();
+}

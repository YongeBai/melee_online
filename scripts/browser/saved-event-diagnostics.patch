+#ifdef __EMSCRIPTEN__
+std::string CoreTimingManager::DescribeBrowserEvents() const
+{
+  // Copy and sort only the diagnostic view. Ties retain the scheduler's fifo_order.
+  auto ordered = m_event_queue;
+  std::ranges::sort(ordered);
+  picojson::array events;
+  bool orders_valid = true;
+  for (const Event& ev : ordered)
+  {
+    orders_valid &= ev.fifo_order < m_event_fifo_id;
+    picojson::object event;
+    event["time"] = picojson::value(std::to_string(ev.time));
+    event["order"] = picojson::value(std::to_string(ev.fifo_order));
+    event["userdata"] = picojson::value(std::to_string(ev.userdata));
+    event["name"] = picojson::value(*ev.type->name);
+    events.emplace_back(event);
+  }
+  picojson::object snapshot;
+  snapshot["globalTimer"] = picojson::value(std::to_string(m_globals.global_timer));
+  snapshot["idleCycles"] = picojson::value(std::to_string(m_idled_cycles));
+  snapshot["nextOrder"] = picojson::value(std::to_string(m_event_fifo_id));
+  snapshot["ordersValid"] = picojson::value(orders_valid);
+  snapshot["guestPc"] = picojson::value(std::to_string(m_system.GetPPCState().pc));
+  snapshot["guestStackPointer"] = picojson::value(std::to_string(m_system.GetPPCState().gpr[1]));
+  snapshot["events"] = picojson::value(events);
+  return picojson::value(snapshot).serialize();
+}
+#endif

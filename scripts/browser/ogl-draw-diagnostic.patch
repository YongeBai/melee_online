 namespace OGL
 {
+#ifdef __EMSCRIPTEN__
+// Bounded diagnostic for the experimental browser core, not a performance mode.
+static void TraceBrowserDraw(const char* phase)
+{
+  static unsigned errors = 0;
+  static unsigned checks = 0;
+  if (errors >= 8 || checks >= 128)
+    return;
+  ++checks;
+  const GLenum error = glGetError();
+  if (error == GL_NO_ERROR)
+    return;
+  ++errors;
+  char* details = static_cast<char*>(EM_ASM_PTR({
+    const gl = GL.currentContext.GLctx;
+    const program = gl.getParameter(gl.CURRENT_PROGRAM);
+    if (program) gl.validateProgram(program);
+    const blocks = program ? Array.from({length: gl.getProgramParameter(program, gl.ACTIVE_UNIFORM_BLOCKS)}, (_, i) => {
+      const binding = gl.getActiveUniformBlockParameter(program, i, gl.UNIFORM_BLOCK_BINDING);
+      return {name: gl.getActiveUniformBlockName(program, i), binding,
+        required: gl.getActiveUniformBlockParameter(program, i, gl.UNIFORM_BLOCK_DATA_SIZE),
+        buffer: Boolean(gl.getIndexedParameter(gl.UNIFORM_BUFFER_BINDING, binding)),
+        size: gl.getIndexedParameter(gl.UNIFORM_BUFFER_SIZE, binding)};
+    }) : [];
+    const attributes = program ? Array.from({length: gl.getProgramParameter(program, gl.ACTIVE_ATTRIBUTES)}, (_, i) => {
+      const a = gl.getActiveAttrib(program, i), loc = gl.getAttribLocation(program, a.name);
+      if (loc < 0) return {name: a.name, type: a.type, loc};
+      return {name: a.name, type: a.type, loc,
+        enabled: gl.getVertexAttrib(loc, gl.VERTEX_ATTRIB_ARRAY_ENABLED),
+        integer: gl.getVertexAttrib(loc, gl.VERTEX_ATTRIB_ARRAY_INTEGER),
+        buffer: Boolean(gl.getVertexAttrib(loc, gl.VERTEX_ATTRIB_ARRAY_BUFFER_BINDING))};
+    }) : [];
+    const text = JSON.stringify({blocks, attributes,
+      program: program?.name || null,
+      valid: program ? gl.getProgramParameter(program, gl.VALIDATE_STATUS) : false,
+      validation: program ? gl.getProgramInfoLog(program) : 'No current program',
+      framebuffer: gl.checkFramebufferStatus(gl.FRAMEBUFFER),
+      vertexArray: Boolean(gl.getParameter(gl.VERTEX_ARRAY_BINDING)),
+      elementBuffer: Boolean(gl.getParameter(gl.ELEMENT_ARRAY_BUFFER_BINDING))
+    });
+    const length = lengthBytesUTF8(text) + 1;
+    const ptr = _malloc(length);
+    stringToUTF8(text, ptr, length);
+    return ptr;
+  }));
+  ERROR_LOG_FMT(VIDEO, "Browser draw {} GL error {:#x}: {}", phase, error, details);
+  std::free(details);
+}
+#endif

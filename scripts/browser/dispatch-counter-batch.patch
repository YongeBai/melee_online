+// CPU-thread-owned accumulator. Publish once when this dispatch invocation
+// returns, before its caller can advance hardware or acknowledge a pause.
+// Readers retain an atomic snapshot; completed calls retain exact totals.
+class ScopedDispatchCounter
+{
+public:
+  ScopedDispatchCounter(std::atomic<u32>& total, std::atomic<u32>& batches, bool batch)
+      : m_total(total), m_batches(batches), m_batch(batch) {}
+  ScopedDispatchCounter(const ScopedDispatchCounter&) = delete;
+  ScopedDispatchCounter& operator=(const ScopedDispatchCounter&) = delete;
+  void Hit()
+  {
+    if (m_batch) ++m_pending;
+    else m_total.fetch_add(1, std::memory_order_relaxed);
+  }
+  ~ScopedDispatchCounter()
+  {
+    if (m_pending)
+    {
+      m_total.fetch_add(m_pending, std::memory_order_relaxed);
+      m_batches.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+private:
+  std::atomic<u32>& m_total;
+  std::atomic<u32>& m_batches;
+  const bool m_batch;
+  u32 m_pending = 0;
+};

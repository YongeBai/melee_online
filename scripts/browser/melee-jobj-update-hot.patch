+bool CachedInterpreter::TryWriteMeleeJObjUpdate(PowerPC::PowerPCManager& power_pc)
+{
+  constexpr u32 start = 0x8036fdc0;
+  constexpr u32 end = 0x80370780;
+  // FNV-1a over every instruction byte in the unmodified GALE01 1.02
+  // JObjUpdateFunc. The shortcut below is tied to the complete switch body,
+  // not merely its entry opcode or symbol name.

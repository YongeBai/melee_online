+      IsProfilingEnabled() || jo.memcheck)
+  {
+    return false;
+  }
+
+  u32 signature = 2166136261u;
+  const auto read = [&](u32 address) -> std::optional<UGeckoInstruction> {
+    const auto result = m_system.GetMMU().TryReadInstruction(address);
+    if (!result.valid)
+      return std::nullopt;
+    return UGeckoInstruction{result.hex};
+  };
+  for (u32 address = start; address < end; address += sizeof(u32))
+  {
+    const auto inst = read(address);
+    if (!inst)
+      return false;
+    for (s32 shift = 24; shift >= 0; shift -= 8)
+    {
+      signature ^= (inst->hex >> shift) & 0xff;
+      signature *= 16777619u;
+    }
+  }
+  if (signature != expected_signature)
+    return false;
+
+  using Metric = std::array<u32, 3>;
+  const auto add_instruction = [&](Metric& metric, u32 address) {
+    const auto inst = read(address);
+    if (!inst)
+      return false;
+    const GekkoOPInfo* opinfo = PPCTables::GetOpInfo(*inst, address);
+    metric[0] += opinfo->num_cycles;
+    if ((opinfo->flags & FL_LOADSTORE) != 0)
+      ++metric[1];
+    if ((opinfo->flags & FL_USE_FPU) != 0)
+      ++metric[2];
+    return true;
+  };
+  const auto add_addresses = [&](Metric& metric, std::initializer_list<u32> addresses) {
+    for (const u32 address : addresses)
+      if (!add_instruction(metric, address))
+        return false;
+    return true;
+  };
+  Metric common{};
+  for (u32 address = start; address <= 0x8036fe08; address += sizeof(u32))
+    if (!add_instruction(common, address))
+      return false;
+  for (u32 address = 0x80370768; address <= 0x8037077c; address += sizeof(u32))
+    if (!add_instruction(common, address))
+      return false;

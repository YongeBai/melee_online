+// Native CPU timestamps bracket exactly the requested controller-poll span.
+// Keep wall time outside deterministic input/state fingerprints.
+EMSCRIPTEN_KEEPALIVE const char* BrowserFrameBenchmarkTiming()
+{
+  static std::string result;
+  const std::lock_guard<std::mutex> lock(s_input_state_mutex);const auto& b=s_frame_benchmark;
+  const double elapsed=b.completed&&b.timed_start?std::chrono::duration<double,std::milli>(b.time_stop-b.time_start).count():0;
+  const bool valid=b.valid&&b.completed&&b.timed_start&&b.stop_after&&
+      b.timed_start_frame==b.start&&b.stopped_frame-b.start==b.stop_after&&elapsed>0;
+  result="{\"valid\":"+std::string(valid?"true":"false")+",\"frames\":"+std::to_string(b.stop_after)+
+      ",\"startFrame\":"+std::to_string(b.timed_start_frame)+",\"stopFrame\":"+std::to_string(b.stopped_frame)+
+      ",\"elapsedMs\":"+std::to_string(elapsed)+"}";
+  return result.c_str();
+}

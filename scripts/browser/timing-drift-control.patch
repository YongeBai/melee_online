+// Query (-1) or configure (0/1) host pacing while owning the paused CPU.
+// This does not alter the virtual clock, instructions, GPU mode or JIT cache.
+EMSCRIPTEN_KEEPALIVE const char* BrowserTimingDrift(int mode)
+{
+  auto& system = Core::System::GetInstance();
+  if (!s_runtime_initialized || mode < -1 || mode > 1 ||
+      Core::GetState(system) != Core::State::Paused)
+    return "{\"error\":\"Timing drift control requires a paused machine and -1/0/1\"}";
+  const Core::CPUThreadGuard guard(system);
+  auto& timing = system.GetCoreTiming();
+  if (mode != -1)
+  {
+    Config::SetBase(Config::MAIN_CORRECT_TIME_DRIFT, mode != 0);
+    timing.SetBrowserCorrectTimeDrift(mode != 0);
+  }
+  const auto stats = timing.GetBrowserThrottleStats();
+  static std::string result;
+  result = "{\"enabled\":" + std::string(timing.GetBrowserCorrectTimeDrift() ? "true" : "false") +
+      ",\"relaxCount\":" + std::to_string(stats.count) +
+      ",\"relaxUs\":" + std::to_string(stats.microseconds) +
+      ",\"relaxMaxUs\":" + std::to_string(stats.maximum_microseconds) + "}";
+  return result.c_str();
+}

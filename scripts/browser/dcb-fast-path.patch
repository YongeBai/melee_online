+// Match Jit64::dcbx's empty-code-line fast path. Unknown translations,
+// privileged dcbi, accurate data caching, and live code all use the original
+// helper. Read the live IBAT and bitmap, never assume MEM1 aliases or retain
+// a cached mapping across a restore. Bit 24 is an opt-in runtime QA gate.
+void EmitDcbx(std::vector<u8>& body, const WasmStateLayout& layout,
+              const PPCAnalyst::CodeOp& op, u32 downcount)
+{
+  if (!layout.ibat_base || !layout.valid_blocks_base)
+  {
+    EmitSystemCall(body, op, downcount);
+    return;
+  }
+  body.insert(body.end(), {0x02, 0x40, 0x02, 0x40}); // done { slow {
+  EmitI32Const(body, static_cast<u32>(reinterpret_cast<std::uintptr_t>(&s_dolphin_web_disable_mask)));
+  body.insert(body.end(), {0xfe, 0x10, 0x02, 0x00}); // i32.atomic.load
+  EmitI32Const(body, 1u << 24);
+  body.push_back(0x71);
+  body.push_back(0x45);
+  body.insert(body.end(), {0x0d, 0x00}); // disabled -> slow
+  EmitStateLoadU8(body, layout.dcache_enabled_offset);
+  body.insert(body.end(), {0x0d, 0x00});
+  if (op.inst.SUBOP10 == 470)
+  {
+    EmitStateLoadU32(body, layout.msr_offset);
+    EmitI32Const(body, 1u << 14); // MSR.PR
+    body.push_back(0x71);
+    body.insert(body.end(), {0x0d, 0x00});
+  }
+  EmitEffectiveAddressX(body, layout, op.inst);
+  EmitLocalSet(body, 1);
+  EmitLocalGet(body, 1);
+  EmitLocalSet(body, 2);
+  EmitStateLoadU32(body, layout.msr_offset);
+  EmitI32Const(body, 1u << 5); // MSR.IR
+  body.push_back(0x71);
+  body.insert(body.end(), {0x04, 0x40});
+  EmitI32Const(body, layout.ibat_base);
+  EmitLocalGet(body, 1);
+  EmitI32Const(body, PowerPC::BAT_INDEX_SHIFT);
+  body.push_back(0x76);
+  EmitI32Const(body, 2);
+  body.push_back(0x74);
+  body.push_back(0x6a);
+  body.insert(body.end(), {0x28, 0x02, 0x00});
+  EmitLocalSet(body, 3);
+  EmitLocalGet(body, 3);
+  EmitI32Const(body, PowerPC::BAT_MAPPED_BIT);
+  body.push_back(0x71);
+  body.push_back(0x45);
+  body.insert(body.end(), {0x0d, 0x01}); // exit if + slow, keep done
+  EmitLocalGet(body, 3);
+  EmitI32Const(body, ~(PowerPC::BAT_PAGE_SIZE - 1u));
+  body.push_back(0x71);
+  EmitLocalGet(body, 1);
+  EmitI32Const(body, PowerPC::BAT_PAGE_SIZE - 1u);
+  body.push_back(0x71);
+  body.push_back(0x72);
+  EmitLocalSet(body, 2);
+  body.push_back(0x0b);
+  EmitI32Const(body, layout.valid_blocks_base);
+  EmitLocalGet(body, 2);
+  EmitI32Const(body, 10); // 32-byte lines, 32 lines per bitmap word
+  body.push_back(0x76);
+  EmitI32Const(body, 2);
+  body.push_back(0x74);
+  body.push_back(0x6a);
+  body.insert(body.end(), {0x28, 0x02, 0x00});
+  EmitI32Const(body, 1);
+  EmitLocalGet(body, 2);
+  EmitI32Const(body, 5);
+  body.push_back(0x76);
+  body.push_back(0x74); // WASM shift masks to five bits
+  body.push_back(0x71);
+  body.insert(body.end(), {0x0d, 0x00, 0x0c, 0x01, 0x0b});
+  EmitSystemCall(body, op, downcount);
+  body.push_back(0x0b);
+}

+bool DecodeTwoControllerInputs(const std::uint32_t* packed, int count, std::uint32_t frame,
+                               std::array<InputStateSnapshot, 2>* decoded)
+{
+  if (!packed || count != 18 || !decoded) return false;
+  std::array<InputStateSnapshot, 2> next{};
+  for (unsigned port = 0; port < 2; ++port)
+  {
+    const auto* p = packed + port * 9;
+    if (p[0] > 0xfffffu) return false;
+    for (unsigned field = 1; field < 9; ++field) if (p[field] > 255) return false;
+    auto& input = next[port];
+    input.mask = p[0]; input.generation = frame;
+    input.stick_x = p[1]; input.stick_y = p[2];
+    input.c_stick_x = p[3]; input.c_stick_y = p[4];
+    input.trigger_left = p[5]; input.trigger_right = p[6];
+    input.analog_a = p[7]; input.analog_b = p[8];
+  }
+  *decoded = next;
+  return true;
+}
+
+bool ReadControllerInput(int port, InputStateSnapshot* input)
+{
+  if (!input || port < 0 || port >= 2) return false;
+  const std::lock_guard<std::mutex> lock(s_input_state_mutex);
+  if (s_rollback_input_owner) *input = s_rollback_inputs[port];
+  else if (s_live_input_owner) *input = s_live_inputs[port];
+  else if (port == 0) *input = s_input_state;
+  else return false;
+  return true;
+}

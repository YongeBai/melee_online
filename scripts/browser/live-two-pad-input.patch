+// Private two-controller QA input. Live ownership never pauses emulation;
+// authoritative rollback input takes precedence until it is released.
+EMSCRIPTEN_KEEPALIVE int BrowserLiveSetPads(const u32* packed, int count, u32 frame)
+{
+  if (!s_runtime_initialized) return 0;
+  const auto state = Core::GetState(Core::System::GetInstance());
+  if (state != Core::State::Running && state != Core::State::Paused) return 0;
+  std::array<InputStateSnapshot, 2> next{};
+  if (!DecodeTwoControllerInputs(packed, count, frame, &next)) return 0;
+  const std::lock_guard<std::mutex> lock(s_input_state_mutex);
+  s_live_inputs = next;
+  s_live_input_owner = true;
+  return 1;
+}
+EMSCRIPTEN_KEEPALIVE int BrowserLiveReleasePads()
+{
+  const std::lock_guard<std::mutex> lock(s_input_state_mutex);
+  s_live_input_owner = false;
+  s_live_inputs = {};
+  return 1;
+}

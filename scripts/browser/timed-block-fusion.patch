+void EmitFusionBoundary(std::vector<u8>& body, const WasmFusionBoundary& boundary,
+                        u32 cycles)
+{
+  // B and its helpers must see the same live budget/PC as separate dispatch.
+  EmitStateLoadU32(body, boundary.downcount_offset);
+  EmitI32Const(body, cycles); body.push_back(0x6b); EmitLocalSet(body, 3);
+  EmitStateStoreU32Prefix(body); EmitLocalGet(body, 3);
+  EmitStateStoreU32Suffix(body, boundary.downcount_offset);
+  EmitStateStoreU32Prefix(body); EmitI32Const(body, boundary.target_pc);
+  EmitStateStoreU32Suffix(body, boundary.pc_offset);
+  const auto absolute = [&](u32 pointer) {
+    EmitI32Const(body, pointer); body.insert(body.end(), {0x28, 2, 0});
+  };
+  EmitLocalGet(body, 3); EmitI32Const(body, 0); body.push_back(0x4c);
+  absolute(boundary.cpu_state); EmitI32Const(body, boundary.running_state);
+  body.push_back(0x47); body.push_back(0x72);
+  EmitI32Const(body, boundary.step_armed);
+  body.insert(body.end(), {0xfe, 0x12, 0, 0, 0x04, 0x7f});
+  absolute(boundary.step_counter); absolute(boundary.step_start); body.push_back(0x47);
+  body.push_back(0x05); EmitI32Const(body, 0); body.push_back(0x0b);
+  body.push_back(0x72);
+  body.insert(body.end(), {0x04, 0x40});
+  EmitRegCacheFlushDirty(body);
+  EmitI32Const(body, 1); body.push_back(0x0f); body.push_back(0x0b);
+}

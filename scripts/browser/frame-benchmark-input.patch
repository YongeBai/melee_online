+bool ReadFrameBenchmarkInput(int port,InputStateSnapshot* input)
+{
+  if (!s_frame_benchmark.active) return false;
+  auto& b=s_frame_benchmark;
+  // Frontend inspection must not sample mutable guest state or advance the
+  // script. The CPU thread is the sole producer of native poll snapshots.
+  if (!Core::IsCPUThread()) {*input=b.pads[port];return true;}
+  DolphinWeb::FrameBenchmark::State state;
+  if (!DolphinWeb::FrameBenchmark::Read(Core::System::GetInstance().GetMemory().GetRAM(),0x1800000,&state))
+  {b.valid=false;*input={};return true;}
+  if (!b.have_frame || b.last!=state.frame)
+  {
+    const u32 relative=state.frame-b.start;
+    if (relative>7200) {b.valid=false;*input={};return true;}
+    if (b.have_frame && state.frame-b.last!=1) {b.skipped+=state.frame-b.last-1;b.valid=false;}
+    b.have_frame=true;b.last=state.frame;++b.frames;
+    std::array<u32,18> packed{};
+    for (u32 p=0;p<2;++p)
+    {
+      const auto pad=DolphinWeb::FrameBenchmark::Input(state,p);
+      if (b.frames==1 || pad!=b.previous[p])++b.changes[p];
+      b.previous[p]=pad;
+      std::copy(pad.begin(),pad.end(),packed.begin()+p*9);
+      if (state.fighters[p].action<512)b.actions[p][state.fighters[p].action]=true;
+      for (u32 value:pad)b.input_hash=DolphinWeb::FrameBenchmark::HashWord(b.input_hash,value);
+      u32 x;std::memcpy(&x,&state.fighters[p].x,4);
+      for (u32 value:{x,state.fighters[p].action,state.fighters[p].stocks})
+        b.state_hash=DolphinWeb::FrameBenchmark::HashWord(b.state_hash,value);
+    }
+    DecodeTwoControllerInputs(packed.data(),18,state.frame,&b.pads);
+    if (relative && relative%120==0)b.digests.push_back({relative,b.input_hash,b.state_hash});
+  }
+  *input=b.pads[port];return true;
+}

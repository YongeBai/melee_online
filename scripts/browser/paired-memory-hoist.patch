+// Opt-in paired-memory range checks. A run contains only non-update psq
+// accesses and paired arithmetic/merges. No instruction can change a base GPR,
+// MSR, HID2 or GQR. Exceptional memory helpers leave the compiled block.
+struct WasmPsqHoistPlan
+{
+  struct Group { u32 base=0, quant=0; bool store=false; s32 lo=0, hi=0; u32 local=0; };
+  struct Member { u32 group=0; bool first=false; };
+  std::vector<Group> groups;
+  std::unordered_map<const PPCAnalyst::CodeOp*, Member> members;
+};
+static WasmPsqHoistPlan s_psq_hoist;
+
+void AnalyzePsqHoistPlan(std::span<const PPCAnalyst::CodeOp> ops)
+{
+  s_psq_hoist = {};
+  if (!s_dolphin_web_psq_hoist.load(std::memory_order_relaxed)) return;
+  struct Pending { WasmPsqHoistPlan::Group group; std::vector<const PPCAnalyst::CodeOp*> ops; };
+  std::map<u32, Pending> pending;
+  const auto finish = [&]() {
+    for (const auto& [key,p] : pending)
+    {
+      if (p.ops.size()<2) continue;
+      const u32 index=static_cast<u32>(s_psq_hoist.groups.size());
+      s_psq_hoist.groups.push_back(p.group);
+      for (std::size_t i=0;i<p.ops.size();++i) s_psq_hoist.members[p.ops[i]]={index,i==0};
+    }
+    pending.clear();
+  };
+  for (const auto& op : ops)
+  {
+    if (op.skip) continue;
+    const auto inst=op.inst;
+    if ((inst.OPCD==56 || inst.OPCD==60) && inst.RA!=0)
+    {
+      const bool store=inst.OPCD==60;
+      const u32 key=(inst.RA*8+inst.I)*2+store;
+      const s32 lo=static_cast<s32>(inst.SIMM_12);
+      const s32 hi=lo+(inst.W?4:8)-1;
+      auto& p=pending[key];
+      if (p.ops.empty()) p.group={inst.RA,inst.I,store,lo,hi,0};
+      else { p.group.lo=std::min(p.group.lo,lo);p.group.hi=std::max(p.group.hi,hi); }
+      p.ops.push_back(&op);
+    }
+    else if (inst.OPCD!=4 || inst.Rc ||
+             (!IsPairedSingleArithmeticSubop(inst.SUBOP5) && !IsPairedSingleMergeSubop(inst.SUBOP10)))
+      finish();
+  }
+  finish();
+}
